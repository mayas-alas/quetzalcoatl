pocket.gnx {
    bind {$GNX_BIND}
    tls /etc/gnx/tls/node.crt /etc/gnx/tls/node.key
    reverse_proxy 172.30.0.100:1411
}

s3.gnx {
    bind {$GNX_BIND}
    tls /etc/gnx/tls/node.crt /etc/gnx/tls/node.key
    reverse_proxy 172.30.0.100:9000
}

rustfs.gnx {
    bind {$GNX_BIND}
    tls /etc/gnx/tls/node.crt /etc/gnx/tls/node.key

    @browserEntry {
        path /
        method GET HEAD
        header Accept *text/html*
        not header Authorization *
    }
    redir @browserEntry /rustfs/console/ 302
    redir /rustfs/console /rustfs/console/ 308

    @admin path /rustfs/admin/*
    handle @admin {
        reverse_proxy 172.30.0.100:9000
    }
    @consoleRuntime path /rustfs/console/version /rustfs/console/license /rustfs/console/health /rustfs/console/health/*
    handle @consoleRuntime {
        reverse_proxy 172.30.0.100:9001
    }
    handle_path /rustfs/console/* {
        root * /srv/gnx/rustfs-console-v0.1.38
        header X-GnX-RustFS-Console v0.1.38
        header Cache-Control no-cache
        file_server
    }
    handle {
        reverse_proxy 172.30.0.100:9001
    }
}

netbird.gnx {
    bind {$GNX_BIND}
    tls /etc/gnx/tls/node.crt /etc/gnx/tls/node.key
    @grpc header Content-Type application/grpc*
    reverse_proxy @grpc h2c://172.30.0.100:8081
    @backend path /relay* /ws-proxy/* /api/* /oauth2/*
    reverse_proxy @backend 172.30.0.100:8081
    reverse_proxy 172.30.0.100:8080
}
