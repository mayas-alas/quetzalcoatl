[Unit]
Description=GnX local HTTPS gateway
PartOf=gnx-core.target

[Quadlet]
DefaultDependencies=false

[Container]
Image=sha256:2d8b1708bf8008935c0e2a9b6564f7f080cf9a73af3b27718f286230449b7101
Pull=never
ContainerName=gnx-core-gateway
Network=host
EnvironmentFile=/var/lib/gnx-core/gateway.env
Volume=/etc/gnx-core/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/var/lib/gnx-core/tls/root.crt:/etc/gnx/tls/root.crt:ro
Volume=/var/lib/gnx-core/tls/node.crt:/etc/gnx/tls/node.crt:ro
Volume=/var/lib/gnx-core/tls/node.key:/etc/gnx/tls/node.key:ro
Volume=/var/lib/gnx-core/web:/srv/gnx:ro
Volume=/var/lib/gnx-core/gateway-data:/data
Volume=/var/lib/gnx-core/gateway-config:/config
LogDriver=journald
StopTimeout=20

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s

[Install]
WantedBy=gnx-core.target
