[Unit]
Description=GnX local HTTPS gateway
PartOf=gnx-core.target
Wants=gnx-core-crl.service
After=gnx-core-crl.service

[Quadlet]
DefaultDependencies=false

[Container]
Image=sha256:3067cc4e02c091399edbd5d65f85a3ff4d511574aecadb47f280c3761e68852e
Pull=never
ContainerName=gnx-core-gateway
Network=host
EnvironmentFile=/var/lib/gnx-core/gateway.env
Volume=/etc/gnx-core/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/var/lib/gnx-core/tls:/etc/gnx/tls:ro
Volume=/var/lib/gnx-core/web:/srv/gnx:ro
Volume=/var/lib/gnx-core/gateway-data:/data
Volume=/var/lib/gnx-core/gateway-config:/config
Volume=/var/lib/gnx-core/stack-gateway:/etc/gnx-stack-gateway:ro
LogDriver=journald
StopTimeout=20

[Service]
ExecStartPre=/usr/bin/bash /etc/gnx-core/configure.run access
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s

[Install]
WantedBy=gnx-core.target
