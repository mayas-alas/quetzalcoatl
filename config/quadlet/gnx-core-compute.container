[Unit]
Description=GnX Proxmox VE, LXC baseline without KVM
PartOf=gnx-core.target
After=gnx-core-gateway.service
ConditionPathExists=/var/lib/gnx-core/secrets/compute.env

[Container]
Image=sha256:00c9293ff01e249b1997dd222b7cd1766cb175fd84cd90b4282d403d4d7fd8fe
Pull=never
ContainerName=gnx-core-compute
HostName=gnx-core-compute
# Stable backend address within the sealed base's Podman bridge.
IP=10.88.0.2
PublishPort=127.0.0.1:8006:8006
AddDevice=/dev/fuse
PodmanArgs=--privileged --systemd=always
Environment=REQUIRE_KVM=N
EnvironmentFile=/var/lib/gnx-core/secrets/compute.env
Volume=/var/lib/gnx-core/compute:/var/lib/vz
Volume=/var/lib/gnx-core/compute-config:/var/lib/pve-cluster
Volume=/var/lib/gnx-core/tls:/etc/gnx/tls:ro
Volume=/etc/gnx-core/install-pve-tls.run:/usr/local/libexec/gnx-install-tls:ro
Volume=/etc/gnx-core/pveproxy.conf:/etc/systemd/system/pveproxy.service.d/gnx.conf:ro
Volume=/etc/gnx-core/stack-dns.conf:/etc/dnsmasq.d/gnx-stack.conf:ro
Volume=/var/lib/gnx-core/stack-dns:/etc/gnx-stack-dns:ro
StopSignal=SIGRTMIN+3
LogDriver=journald
HealthCmd=/usr/bin/pvesh get /cluster/resources --type vm --output-format json
HealthInterval=5s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=10s
Notify=healthy
StopTimeout=120

[Service]
ExecStartPost=/usr/bin/bash /etc/gnx-core/stack-access.run reconcile
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=130s

[Install]
WantedBy=gnx-core.target
