[Unit]
Description=GnX Tailscale mesh, independent of local access
PartOf=gnx-core.target

[Container]
Image=sha256:9cb91ed119a2c502813cfef5a14430944163dfb2b290ccfc69d671d1469ec09d
Pull=never
ContainerName=gnx-core-mesh
Network=host
Tmpfs=/run:rw,nodev,nosuid,noexec,mode=0755
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN NET_RAW
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_USERSPACE=false
Environment=TS_AUTH_ONCE=true
Environment=TS_EXTRA_ARGS=--accept-dns=false
Volume=/var/lib/gnx-core/mesh:/var/lib/tailscale
LogDriver=journald
StopTimeout=20

[Service]
ExecStartPost=/usr/bin/podman exec gnx-core-mesh tailscale wait
ExecStartPost=/usr/bin/bash /etc/gnx-core/configure.run mesh-access
Restart=on-failure
RestartSec=5s
# Native readiness can await the first user key; gateway/target never wait on it.
TimeoutStartSec=infinity
TimeoutStopSec=30s

[Install]
WantedBy=gnx-core.target
