[Unit]
Description=GnX mesh resolver for gnx domains
PartOf=gnx-core.target

[Quadlet]
DefaultDependencies=false

[Container]
Image=sha256:c3c5f5b1ba1fdadb0095bc3985ff3de599fd51317b8d5efe6001f9d704723e80
Pull=never
ContainerName=gnx-core-dns
Network=host
Environment=SKIPGRAVITYONBOOT=1
Environment=FTLCONF_webserver_port=
Environment=FTLCONF_ntp_ipv4_active=false
Environment=FTLCONF_ntp_ipv6_active=false
EnvironmentFile=/var/lib/gnx-core/dns.env
Volume=/var/lib/gnx-core/dns:/etc/pihole
LogDriver=journald
StopTimeout=20

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s

[Install]
WantedBy=gnx-core.target
