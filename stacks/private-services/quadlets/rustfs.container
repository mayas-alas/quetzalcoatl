[Unit]
Description=RustFS
After=pocket-id.service

[Container]
Image=docker.io/rustfs/rustfs@sha256:ed9210d6411d77ffceb70d94b964a3cb7d225983368bc25bebe01e995293dcc2
ContainerName=rustfs
Network=private.network
NetworkAlias=rustfs
PublishPort=172.30.0.100:9000:9000
PublishPort=172.30.0.100:9001:9001
Pull=missing
Environment=RUSTFS_VOLUMES=/data
Environment=RUSTFS_CONSOLE_ENABLE=true
Environment=RUSTFS_BROWSER_REDIRECT_URL=https://rustfs.gnx
Environment=RUSTFS_EXTRA_CA_CERT=/etc/gnx/root.crt
Environment=RUSTFS_OUTBOUND_ALLOW_ORIGINS=https://pocket.gnx,https://rustfs.gnx
EnvironmentFile=/etc/gnx-app/config/rustfs.env
Volume=/var/lib/gnx-app/rustfs/data:/data:U
Volume=/var/lib/gnx-app/rustfs/logs:/logs:U
Volume=/etc/gnx-app/config/root.crt:/etc/gnx/root.crt:ro

[Service]
Restart=on-failure
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
