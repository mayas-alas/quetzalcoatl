[Unit]
Description=Pocket ID

[Container]
Image=ghcr.io/pocket-id/pocket-id@sha256:f085157f0b6ea4b2e8aa5ecfd99eada0d83a4960f3a3dcfd46014097d0ef7ab5
ContainerName=pocket-id
Network=private.network
NetworkAlias=pocket-id
PublishPort=172.30.0.100:1411:1411
Pull=missing
Environment=APP_URL=https://pocket.gnx
Environment=TRUST_PROXY=10.88.0.1/32,172.30.0.1/32
Environment=ANALYTICS_DISABLED=true
Environment=VERSION_CHECK_DISABLED=true
Environment=ICON_LIBRARY_URL=disabled
Environment=ALLOW_INSECURE_CALLBACK_URLS=false
EnvironmentFile=/etc/gnx-app/config/pocket.env
Volume=/var/lib/gnx-app/pocket-id:/app/data:U

[Service]
Restart=on-failure
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
