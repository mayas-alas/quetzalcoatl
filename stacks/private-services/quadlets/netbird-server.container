[Unit]
Description=NetBird combined server
After=pocket-id.service

[Container]
Image=docker.io/netbirdio/netbird-server@sha256:7b5b53b2dc8bc25639f791cf72d47cf86911894ff3f8a97cb79bab9be958109c
ContainerName=netbird-server
Network=private.network
NetworkAlias=netbird-server
PublishPort=172.30.0.100:8081:8081
PublishPort=172.30.0.100:3478:3478/udp
Pull=missing
Environment=NB_DISABLE_GEOLOCATION=true
Environment=NB_SETUP_PAT_ENABLED=true
Environment=SSL_CERT_FILE=/etc/gnx/root.crt
Volume=/var/lib/gnx-app/netbird:/var/lib/netbird
Volume=/etc/gnx-app/config/netbird.yaml:/etc/netbird/config.yaml:ro
Volume=/etc/gnx-app/config/root.crt:/etc/gnx/root.crt:ro

[Service]
Restart=on-failure
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
