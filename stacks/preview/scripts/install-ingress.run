#!/usr/bin/bash
# Prepare fixed node assets; target/CA/LXC ownership are checked before publication.
set -euo pipefail
umask 077
[[ $(id -u) == 0 ]]
bundle=${1:?verified bundle directory required}
target=${2:?root-owned managed target JSON required}
cd "$bundle"
sha256sum --strict -c SHA256SUMS
[[ -f /var/lib/gnx-core/tls/root.crt && -f /var/lib/gnx-core/ca-private/root.key ]]
[[ -f "$target" && ! -L "$target" && $(stat -c %u "$target") == 0 && $(stat -c %a "$target") == 600 ]]
jq -e '.ca_sha256|test("^[a-f0-9]{64}$")' "$target" >/dev/null
[[ $(openssl x509 -in /var/lib/gnx-core/tls/root.crt -outform DER | sha256sum | cut -d' ' -f1) == $(jq -r .ca_sha256 "$target") ]]
# No CA generation here. SAN renewal uses the existing tls.run, CA and database.
install -m 0644 integration/config/pki/node.ext /etc/gnx-core/node.ext
install -m 0755 integration/scripts/tls.run /etc/gnx-core/tls.run
bash /etc/gnx-core/tls.run refresh
install -m 0644 gateway.caddy /etc/gnx-core/preview.caddy
install -m 0755 scripts/preview-access.run /etc/gnx-core/preview-access.run
install -d -m 0755 /var/lib/gnx-core/stack-dns
if [[ ! -e /var/lib/gnx-core/stack-dns/preview.conf ]]; then printf '# No preview registered.\n' > /var/lib/gnx-core/stack-dns/preview.conf; fi
[[ -f /etc/gnx-core/stack-dns.conf && ! -L /etc/gnx-core/stack-dns.conf && $(stat -c %u /etc/gnx-core/stack-dns.conf) == 0 ]]
# Keep the inode: the running compute has this file bind-mounted read-only.
cat integration/config/compute/stack-dns.conf > /etc/gnx-core/stack-dns.conf
install -m 0755 integration/scripts/configure.run /etc/gnx-core/configure.run
bash /etc/gnx-core/preview-access.run register "$target"
if ip link show tailscale0 >/dev/null 2>&1; then bash /etc/gnx-core/configure.run mesh-access; fi
# Existing core hooks are not replaced; a native post-start drop-in adds this registry.
install -d -m 0755 /etc/systemd/system/gnx-core-compute.service.d
printf '[Service]\nExecStartPost=/usr/bin/bash /etc/gnx-core/preview-access.run reconcile\n' > /etc/systemd/system/gnx-core-compute.service.d/preview.conf
systemctl daemon-reload
