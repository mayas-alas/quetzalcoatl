#!/bin/sh
set -eu
umask 077
export LC_ALL=C
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

input='/run/gnx/platform-input'
tailscale_image='docker.io/tailscale/tailscale@sha256:2f4584ddb5b8254868f1e2874efa11e7ef1fc554a824ff36e0ab538382e42a8e'
auth_file='/run/gnx/tailscale-auth-key'
config_file='/run/gnx/tailscaled.json'
status_file='/run/gnx/tailscale-status.json'
stage='validate-input'

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  if [ "$result" -ne 0 ]; then
    printf 'LXC_SERVICE_FAILED=%s:%s\n' "${kind:-unknown}" "$stage" >&2
  fi
  rm -f -- "$auth_file" "$config_file" "$status_file" \
    "$status_file.gnx-new" "$input"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

[ "$(id -u)" -eq 0 ]
test -s "$input"
[ "$(stat -c '%u:%g:%a' "$input")" = '0:0:400' ]
exec 3< "$input"
IFS= read -r schema <&3 || exit 64
IFS= read -r kind <&3 || exit 64
IFS= read -r hostname <&3 || exit 64
IFS= read -r tailnet <&3 || exit 64
IFS= read -r auth_key <&3 || exit 64

[ "$schema" = 1 ]
case "$kind:$hostname" in
  garage:gnx-garage|forgejo:gnx-forgejo|runner:gnx-runner|service:gnx-svc-*) ;;
  *) exit 64 ;;
esac
case "$hostname" in *[!a-z0-9-]*|*-|'') exit 64 ;; esac
case "$tailnet" in *.ts.net) ;; *) exit 64 ;; esac
case "$tailnet" in *[!a-z0-9.-]*|.*|*.|*..*) exit 64 ;; esac
case "$auth_key" in tskey-auth-*) ;; *) exit 64 ;; esac
[ "${#auth_key}" -ge 20 ] && [ "${#auth_key}" -le 512 ]
command -v docker >/dev/null
systemctl is-active --quiet docker.service

valid_hex() {
  value=$1
  length=$2
  [ "${#value}" -eq "$length" ]
  case "$value" in *[!0-9a-f]*) return 1 ;; esac
}

valid_access_key() {
  value=$1
  case "$value" in GK????????????????????????) ;; *) return 1 ;; esac
  case "${value#GK}" in *[!0-9a-f]*) return 1 ;; esac
}

valid_base64url_32() {
  value=$1
  [ "${#value}" -eq 43 ]
  decoded_length=$(printf '%s=' "$value" | tr '_-' '/+' | base64 -d 2>/dev/null | wc -c | tr -d ' ')
  [ "$decoded_length" -eq 32 ]
}

write_atomic() {
  target=$1
  mode=$2
  temporary="$target.gnx-new"
  cat > "$temporary"
  chmod "$mode" "$temporary"
  mv -f "$temporary" "$target"
}

wait_http() {
  url=$1
  attempt=0
  while [ "$attempt" -lt 90 ]; do
    attempt=$((attempt + 1))
    if curl --fail --silent --show-error --max-time 5 "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

constrain_tailscale_mtu() {
  container=$1
  stage="tailscale-$kind-mtu"
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    attempt=$((attempt + 1))
    if docker exec "$container" ip link set dev tailscale0 mtu 1100 >/dev/null 2>&1 &&
       [ "$(docker exec "$container" cat /sys/class/net/tailscale0/mtu 2>/dev/null)" = 1100 ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

enroll_tailscale() {
  scope=$1
  permanent="gnx-$scope-tailscale"
  state_dir="/var/lib/quetzalcoatl/tailscale/$scope"
  temporary="gnx-$scope-enroll"

  stage="tailscale-$scope-state"
  install -d -m 0700 "$state_dir" /run/gnx
  if [ ! -s "$state_dir/tailscaled.state" ] &&
     [ -s /var/lib/tailscale/tailscaled.state ]; then
    systemctl stop tailscaled.service >/dev/null 2>&1 || true
    install -m 0600 /var/lib/tailscale/tailscaled.state \
      "$state_dir/tailscaled.state.gnx-new"
    mv -f "$state_dir/tailscaled.state.gnx-new" "$state_dir/tailscaled.state"
  fi
  systemctl disable --now tailscaled.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/tailscaled.service
  rm -rf /run/systemd/system/tailscaled.service.d
  systemctl daemon-reload

  if docker inspect "$permanent" >/dev/null 2>&1 &&
     docker exec "$permanent" tailscale status --json > "$status_file.gnx-new" 2>/dev/null &&
     jq -e --arg host "$hostname" '
       .BackendState == "Running" and
       .Self.HostName == $host and
       (.Self.Tags | index("tag:quetzalcoatl-service") != null)
     ' "$status_file.gnx-new" >/dev/null; then
    mv -f "$status_file.gnx-new" "$status_file"
    return 0
  fi

  docker rm -f "$permanent" "$temporary" >/dev/null 2>&1 || true
  printf '%s' "$auth_key" > "$auth_file"
  chmod 0400 "$auth_file"
  {
    printf '%s\n' \
      '{' \
      '  "version": "alpha0",' \
      '  "authKey": "file:/run/secrets/authkey",' \
      '  "locked": true,' \
      '  "enabled": true,'
    printf '  "hostname": "%s",\n' "$hostname"
    printf '%s\n' \
      '  "acceptDNS": true,' \
      '  "netfilterMode": "on"' \
      '}'
  } | write_atomic "$config_file" 0400
  stage="tailscale-$scope-image"
  docker pull --quiet "$tailscale_image" >/dev/null

  stage="tailscale-$scope-enrollment"
  docker run --detach \
    --pull never \
    --name "$temporary" \
    --hostname "$hostname" \
    --device /dev/net/tun \
    --cap-add NET_ADMIN \
    --cap-add NET_RAW \
    --volume "$state_dir:/var/lib/tailscale" \
    --volume "$auth_file:/run/secrets/authkey:ro" \
    --volume "$config_file:/run/gnx/tailscaled.json:ro" \
    --entrypoint /usr/local/bin/tailscaled \
    "$tailscale_image" \
    --config=/run/gnx/tailscaled.json \
    --statedir=/var/lib/tailscale >/dev/null

  attempt=0
  while [ "$attempt" -lt 90 ]; do
    attempt=$((attempt + 1))
    if docker exec "$temporary" tailscale status --json \
         > "$status_file.gnx-new" 2>/dev/null &&
       jq -e --arg host "$hostname" '
         .BackendState == "Running" and
         .Self.HostName == $host and
         (.Self.Tags | index("tag:quetzalcoatl-service") != null)
       ' "$status_file.gnx-new" >/dev/null; then
      mv -f "$status_file.gnx-new" "$status_file"
      docker rm -f "$temporary" >/dev/null
      rm -f "$auth_file" "$config_file"
      rm -f /usr/local/sbin/tailscale /usr/local/sbin/tailscaled
      rm -rf /var/lib/tailscale /var/cache/tailscale_*
      return 0
    fi
    sleep 2
  done
  docker logs --tail 40 "$temporary" >&2 || true
  docker rm -f "$temporary" >/dev/null 2>&1 || true
  return 1
}

write_public_environment() {
  directory=$1
  {
    printf 'TS_HOSTNAME=%s\n' "$hostname"
    printf 'TS_CERT_DOMAIN=%s.%s\n' "$hostname" "$tailnet"
  } | write_atomic "$directory/.env" 0600
}

configure_garage() {
  stage='garage-input'
  IFS= read -r garage_rpc_secret <&3 || exit 64
  IFS= read -r garage_admin_token <&3 || exit 64
  IFS= read -r tofu_access_key <&3 || exit 64
  IFS= read -r tofu_secret_key <&3 || exit 64
  IFS= read -r forgejo_access_key <&3 || exit 64
  IFS= read -r forgejo_secret_key <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  valid_hex "$garage_rpc_secret" 64
  valid_hex "$garage_admin_token" 64
  valid_access_key "$tofu_access_key"
  valid_hex "$tofu_secret_key" 64
  valid_access_key "$forgejo_access_key"
  valid_hex "$forgejo_secret_key" 64

  stage='garage-assets'
  app_dir='/opt/quetzalcoatl/garage'
  install -d -m 0755 "$app_dir" "$app_dir/serve" \
    /var/lib/quetzalcoatl/garage/data /var/lib/quetzalcoatl/garage/meta
  install -d -m 0700 /var/lib/quetzalcoatl/secrets
  {
    printf '%s\n' \
      'metadata_dir = "/var/lib/garage/meta"' \
      'data_dir = "/var/lib/garage/data"' \
      'db_engine = "sqlite"' \
      'replication_factor = 1' \
      'consistency_mode = "consistent"'
    printf 'rpc_secret = "%s"\n' "$garage_rpc_secret"
    printf '%s\n' \
      'rpc_bind_addr = "127.0.0.1:3901"' \
      'rpc_public_addr = "127.0.0.1:3901"' \
      '' \
      '[s3_api]' \
      's3_region = "garage"' \
      'api_bind_addr = "0.0.0.0:3900"' \
      '' \
      '[admin]' \
      'api_bind_addr = "127.0.0.1:3903"'
    printf 'admin_token = "%s"\n' "$garage_admin_token"
  } | write_atomic /var/lib/quetzalcoatl/secrets/garage.toml 0600
  write_public_environment "$app_dir"
  enroll_tailscale garage
  stage='garage-compose'
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing --wait --wait-timeout 300
  constrain_tailscale_mtu gnx-garage-tailscale

  stage='garage-buckets'
  import_tofu=$(printf \
    '{"accessKeyId":"%s","secretAccessKey":"%s","name":"gnx-tofu"}' \
    "$tofu_access_key" "$tofu_secret_key")
  printf '%s' "$import_tofu" |
    docker exec -i gnx-garage /garage json-api ImportKey - >/dev/null 2>&1 || true
  printf '%s' '{"globalAlias":"gnx-tofu-state","localAlias":null}' |
    docker exec -i gnx-garage /garage json-api CreateBucket - >/dev/null 2>&1 || true
  tofu_bucket=$(printf '%s' \
    '{"id":null,"globalAlias":"gnx-tofu-state","search":null}' |
    docker exec -i gnx-garage /garage json-api GetBucketInfo -)
  tofu_bucket_id=$(printf '%s' "$tofu_bucket" |
    jq -er '.id | select(test("^[0-9a-f]{64}$"))')
  allow_tofu=$(printf \
    '{"bucketId":"%s","accessKeyId":"%s","permissions":{"read":true,"write":true,"owner":true}}' \
    "$tofu_bucket_id" "$tofu_access_key")
  printf '%s' "$allow_tofu" |
    docker exec -i gnx-garage /garage json-api AllowBucketKey - >/dev/null

  import_forgejo=$(printf \
    '{"accessKeyId":"%s","secretAccessKey":"%s","name":"gnx-forgejo"}' \
    "$forgejo_access_key" "$forgejo_secret_key")
  printf '%s' "$import_forgejo" |
    docker exec -i gnx-garage /garage json-api ImportKey - >/dev/null 2>&1 || true
  printf '%s' '{"globalAlias":"gnx-forgejo","localAlias":null}' |
    docker exec -i gnx-garage /garage json-api CreateBucket - >/dev/null 2>&1 || true
  forgejo_bucket=$(printf '%s' \
    '{"id":null,"globalAlias":"gnx-forgejo","search":null}' |
    docker exec -i gnx-garage /garage json-api GetBucketInfo -)
  forgejo_bucket_id=$(printf '%s' "$forgejo_bucket" |
    jq -er '.id | select(test("^[0-9a-f]{64}$"))')
  allow_forgejo=$(printf \
    '{"bucketId":"%s","accessKeyId":"%s","permissions":{"read":true,"write":true,"owner":true}}' \
    "$forgejo_bucket_id" "$forgejo_access_key")
  printf '%s' "$allow_forgejo" |
    docker exec -i gnx-garage /garage json-api AllowBucketKey - >/dev/null

  unset garage_rpc_secret garage_admin_token tofu_secret_key forgejo_secret_key
  unset import_tofu import_forgejo allow_tofu allow_forgejo
  printf '%s\n' 'GARAGE=ready'
}

