  chown 1000:1000 /var/lib/quetzalcoatl/forgejo/data/gitea/conf/app.ini
}

configure_forgejo_api() {
  python3 - <<'PY'
import base64
import json
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

lines = Path("/run/gnx/platform-input").read_text(encoding="utf-8").splitlines()
tailnet, admin_password = lines[3], lines[10]
token = Path("/run/gnx/forgejo-api-token").read_text(encoding="utf-8").strip()
base = "http://127.0.0.1:3000"

def request(path, method="GET", body=None, accepted=(200,)):
    data = None if body is None else json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        base + path,
        data=data,
        method=method,
        headers={
            "Accept": "application/json",
            "Authorization": f"token {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            if response.status not in accepted:
                raise RuntimeError(f"{path} returned HTTP {response.status}")
            encoded = response.read()
            return response.status, json.loads(encoded) if encoded else None
    except urllib.error.HTTPError as error:
        if error.code in accepted:
            return error.code, None
        raise

status, _ = request("/api/v1/orgs/gnx-labs", accepted=(200, 404))
if status == 404:
    request(
        "/api/v1/orgs",
        "POST",
        {
            "username": "gnx-labs",
            "full_name": "GNX Labs",
            "description": "Sovereign GNX service repositories",
            "visibility": "private",
            "repo_admin_change_team_access": False,
        },
        (201,),
    )

status, _ = request(
    "/api/v1/repos/gnx-labs/gnx-service-template", accepted=(200, 404)
)
if status == 404:
    request(
        "/api/v1/orgs/gnx-labs/repos",
        "POST",
        {
            "name": "gnx-service-template",
            "description": "Reproducible private GNX service template",
            "private": True,
            "template": True,
            "auto_init": True,
            "default_branch": "main",
        },
        (201,),
    )

files = {
    "Dockerfile": """FROM docker.io/library/nginx@sha256:d67ea0d64d518b1bb04acde3b00f722ac3e9764b3209a9b0a98924ba35e4b779
COPY index.html /usr/share/nginx/html/index.html
""",
    "index.html": """<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><title>GNX service</title></head>
  <body><main><h1>GNX service is ready</h1></main></body>
</html>
""",
    "compose.yml": """services:
  app:
    image: ${GNX_IMAGE:?GNX_IMAGE is required}
    ports:
      - "127.0.0.1:8080:80"
    restart: unless-stopped
""",
    "gnx.service.yml": """schema: 1
port: 8080
exposure: private
health_path: /
""",
    ".forgejo/workflows/build.yml": f"""name: Build OCI image
on:
  push:
    branches: [main]
    paths-ignore: [gnx.release.json]
permissions:
  contents: write
  packages: write
env:
  GNX_REGISTRY: gnx-forgejo.{tailnet}
jobs:
  build:
    runs-on: docker
    steps:
      - name: Checkout
        uses: https://data.forgejo.org/actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
      - name: Authenticate to the sovereign registry
        uses: https://github.com/docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9
        with:
          registry: ${{{{ env.GNX_REGISTRY }}}}
          username: ${{{{ github.actor }}}}
          password: ${{{{ secrets.GITHUB_TOKEN }}}}
      - name: Build and publish by commit
        id: build
        uses: https://github.com/docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8
        with:
          context: .
          push: true
          tags: ${{{{ env.GNX_REGISTRY }}}}/${{{{ github.repository }}}}:${{{{ github.sha }}}}
      - name: Publish the bounded release declaration
        run: |
          set -eu
          printf '{{"schema":1,"source":"%s","commit":"%s","image":"%s/%s@%s","port":8080,"health_path":"/"}}\\n' \\
            "$GITHUB_REPOSITORY" "$GITHUB_SHA" "$GNX_REGISTRY" \\
            "$GITHUB_REPOSITORY" "${{{{ steps.build.outputs.digest }}}}" \\
            > gnx.release.json
          git config user.name "GNX Release"
          git config user.email "release@gnx.invalid"
