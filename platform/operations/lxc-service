#!/bin/sh
set -eu
umask 077
export LC_ALL=C
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

input='/run/gnx/platform-input'
tailscale_image='docker.io/tailscale/tailscale@sha256:2f4584ddb5b8254868f1e2874efa11e7ef1fc554a824ff36e0ab538382e42a8e'
auth_file='/run/gnx/tailscale-auth-key'
config_file='/run/gnx/tailscaled.json'
status_file='/run/gnx/tailscale-status.json'
stage='validate-input'

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  if [ "$result" -ne 0 ]; then
    printf 'LXC_SERVICE_FAILED=%s:%s\n' "${kind:-unknown}" "$stage" >&2
  fi
  rm -f -- "$auth_file" "$config_file" "$status_file" \
    "$status_file.gnx-new" "$input"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

[ "$(id -u)" -eq 0 ]
test -s "$input"
[ "$(stat -c '%u:%g:%a' "$input")" = '0:0:400' ]
exec 3< "$input"
IFS= read -r schema <&3 || exit 64
IFS= read -r kind <&3 || exit 64
IFS= read -r hostname <&3 || exit 64
IFS= read -r tailnet <&3 || exit 64
IFS= read -r auth_key <&3 || exit 64

[ "$schema" = 1 ]
case "$kind:$hostname" in
  garage:gnx-garage|forgejo:gnx-forgejo|runner:gnx-runner|\
  service:freellmapi|service:omniroute|service:harness) ;;
  *) exit 64 ;;
esac
case "$hostname" in *[!a-z0-9-]*|*-|'') exit 64 ;; esac
case "$tailnet" in *.ts.net) ;; *) exit 64 ;; esac
case "$tailnet" in *[!a-z0-9.-]*|.*|*.|*..*) exit 64 ;; esac
case "$auth_key" in tskey-auth-*) ;; *) exit 64 ;; esac
[ "${#auth_key}" -ge 20 ] && [ "${#auth_key}" -le 512 ]
command -v docker >/dev/null
systemctl is-active --quiet docker.service

valid_hex() {
  value=$1
  length=$2
  [ "${#value}" -eq "$length" ]
  case "$value" in *[!0-9a-f]*) return 1 ;; esac
}

valid_access_key() {
  value=$1
  case "$value" in GK????????????????????????) ;; *) return 1 ;; esac
  case "${value#GK}" in *[!0-9a-f]*) return 1 ;; esac
}

valid_base64url_32() {
  value=$1
  [ "${#value}" -eq 43 ]
  decoded_length=$(printf '%s=' "$value" | tr '_-' '/+' | base64 -d 2>/dev/null | wc -c | tr -d ' ')
  [ "$decoded_length" -eq 32 ]
}

write_atomic() {
  target=$1
  mode=$2
  temporary="$target.gnx-new"
  cat > "$temporary"
  chmod "$mode" "$temporary"
  mv -f "$temporary" "$target"
}

wait_http() {
  url=$1
  attempt=0
  while [ "$attempt" -lt 90 ]; do
    attempt=$((attempt + 1))
    if curl --fail --silent --show-error --max-time 5 "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

constrain_tailscale_mtu() {
  container=$1
  stage="tailscale-$kind-mtu"
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    attempt=$((attempt + 1))
    if docker exec "$container" ip link set dev tailscale0 mtu 1100 >/dev/null 2>&1 &&
       [ "$(docker exec "$container" cat /sys/class/net/tailscale0/mtu 2>/dev/null)" = 1100 ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

enroll_tailscale() {
  scope=$1
  enroll_tag=$2
  permanent="gnx-$scope-tailscale"
  state_dir="/var/lib/quetzalcoatl/tailscale/$scope"
  temporary="gnx-$scope-enroll"

  stage="tailscale-$scope-state"
  install -d -m 0700 "$state_dir" /run/gnx
  if [ ! -s "$state_dir/tailscaled.state" ] &&
     [ -s /var/lib/tailscale/tailscaled.state ]; then
    systemctl stop tailscaled.service >/dev/null 2>&1 || true
    install -m 0600 /var/lib/tailscale/tailscaled.state \
      "$state_dir/tailscaled.state.gnx-new"
    mv -f "$state_dir/tailscaled.state.gnx-new" "$state_dir/tailscaled.state"
  fi
  systemctl disable --now tailscaled.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/tailscaled.service
  rm -rf /run/systemd/system/tailscaled.service.d
  systemctl daemon-reload

  if docker inspect "$permanent" >/dev/null 2>&1 &&
     docker exec "$permanent" tailscale status --json > "$status_file.gnx-new" 2>/dev/null &&
     jq -e --arg host "$hostname" --arg tag "$enroll_tag" '
       .BackendState == "Running" and
       .Self.HostName == $host and
       (.Self.Tags | index($tag) != null)
     ' "$status_file.gnx-new" >/dev/null; then
    mv -f "$status_file.gnx-new" "$status_file"
    return 0
  fi

  docker rm -f "$permanent" "$temporary" >/dev/null 2>&1 || true
  printf '%s' "$auth_key" > "$auth_file"
  chmod 0400 "$auth_file"
  {
    printf '%s\n' \
      '{' \
      '  "version": "alpha0",' \
      '  "authKey": "file:/run/secrets/authkey",' \
      '  "locked": true,' \
      '  "enabled": true,'
    printf '  "hostname": "%s",\n' "$hostname"
    printf '  "tags": ["%s"],\n' "$enroll_tag"
    printf '%s\n' \
      '  "acceptDNS": true,' \
      '  "netfilterMode": "on"' \
      '}'
  } | write_atomic "$config_file" 0400
  stage="tailscale-$scope-image"
  docker pull --quiet "$tailscale_image" >/dev/null

  stage="tailscale-$scope-enrollment"
  docker run --detach \
    --pull never \
    --name "$temporary" \
    --hostname "$hostname" \
    --device /dev/net/tun \
    --cap-add NET_ADMIN \
    --cap-add NET_RAW \
    --volume "$state_dir:/var/lib/tailscale" \
    --volume "$auth_file:/run/secrets/authkey:ro" \
    --volume "$config_file:/run/gnx/tailscaled.json:ro" \
    --entrypoint /usr/local/bin/tailscaled \
    "$tailscale_image" \
    --config=/run/gnx/tailscaled.json \
    --statedir=/var/lib/tailscale >/dev/null

  attempt=0
  while [ "$attempt" -lt 90 ]; do
    attempt=$((attempt + 1))
    if docker exec "$temporary" tailscale status --json \
         > "$status_file.gnx-new" 2>/dev/null &&
       jq -e --arg host "$hostname" --arg tag "$enroll_tag" '
         .BackendState == "Running" and
         .Self.HostName == $host and
         (.Self.Tags | index($tag) != null)
       ' "$status_file.gnx-new" >/dev/null; then
      mv -f "$status_file.gnx-new" "$status_file"
      docker rm -f "$temporary" >/dev/null
      rm -f "$auth_file" "$config_file"
      rm -f /usr/local/sbin/tailscale /usr/local/sbin/tailscaled
      rm -rf /var/lib/tailscale /var/cache/tailscale_*
      return 0
    fi
    sleep 2
  done
  docker logs --tail 40 "$temporary" >&2 || true
  docker rm -f "$temporary" >/dev/null 2>&1 || true
  return 1
}

write_public_environment() {
  directory=$1
  {
    printf 'TS_HOSTNAME=%s\n' "$hostname"
    printf 'TS_CERT_DOMAIN=%s.%s\n' "$hostname" "$tailnet"
  } | write_atomic "$directory/.env" 0600
}

configure_garage() {
  stage='garage-input'
  IFS= read -r garage_rpc_secret <&3 || exit 64
  IFS= read -r garage_admin_token <&3 || exit 64
  IFS= read -r tofu_access_key <&3 || exit 64
  IFS= read -r tofu_secret_key <&3 || exit 64
  IFS= read -r forgejo_access_key <&3 || exit 64
  IFS= read -r forgejo_secret_key <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  valid_hex "$garage_rpc_secret" 64
  valid_hex "$garage_admin_token" 64
  valid_access_key "$tofu_access_key"
  valid_hex "$tofu_secret_key" 64
  valid_access_key "$forgejo_access_key"
  valid_hex "$forgejo_secret_key" 64

  stage='garage-assets'
  app_dir='/opt/quetzalcoatl/garage'
  install -d -m 0755 "$app_dir" "$app_dir/serve" \
    /var/lib/quetzalcoatl/garage/data /var/lib/quetzalcoatl/garage/meta
  install -d -m 0700 /var/lib/quetzalcoatl/secrets
  {
    printf '%s\n' \
      'metadata_dir = "/var/lib/garage/meta"' \
      'data_dir = "/var/lib/garage/data"' \
      'db_engine = "sqlite"' \
      'replication_factor = 1' \
      'consistency_mode = "consistent"'
    printf 'rpc_secret = "%s"\n' "$garage_rpc_secret"
    printf '%s\n' \
      'rpc_bind_addr = "127.0.0.1:3901"' \
      'rpc_public_addr = "127.0.0.1:3901"' \
      '' \
      '[s3_api]' \
      's3_region = "garage"' \
      'api_bind_addr = "0.0.0.0:3900"' \
      '' \
      '[admin]' \
      'api_bind_addr = "127.0.0.1:3903"'
    printf 'admin_token = "%s"\n' "$garage_admin_token"
  } | write_atomic /var/lib/quetzalcoatl/secrets/garage.toml 0600
  write_public_environment "$app_dir"
  enroll_tailscale garage tag:quetzalcoatl-service
  stage='garage-compose'
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing --wait --wait-timeout 300
  constrain_tailscale_mtu gnx-garage-tailscale

  stage='garage-buckets'
  import_tofu=$(printf \
    '{"accessKeyId":"%s","secretAccessKey":"%s","name":"gnx-tofu"}' \
    "$tofu_access_key" "$tofu_secret_key")
  printf '%s' "$import_tofu" |
    docker exec -i gnx-garage /garage json-api ImportKey - >/dev/null 2>&1 || true
  printf '%s' '{"globalAlias":"gnx-tofu-state","localAlias":null}' |
    docker exec -i gnx-garage /garage json-api CreateBucket - >/dev/null 2>&1 || true
  tofu_bucket=$(printf '%s' \
    '{"id":null,"globalAlias":"gnx-tofu-state","search":null}' |
    docker exec -i gnx-garage /garage json-api GetBucketInfo -)
  tofu_bucket_id=$(printf '%s' "$tofu_bucket" |
    jq -er '.id | select(test("^[0-9a-f]{64}$"))')
  allow_tofu=$(printf \
    '{"bucketId":"%s","accessKeyId":"%s","permissions":{"read":true,"write":true,"owner":true}}' \
    "$tofu_bucket_id" "$tofu_access_key")
  printf '%s' "$allow_tofu" |
    docker exec -i gnx-garage /garage json-api AllowBucketKey - >/dev/null

  import_forgejo=$(printf \
    '{"accessKeyId":"%s","secretAccessKey":"%s","name":"gnx-forgejo"}' \
    "$forgejo_access_key" "$forgejo_secret_key")
  printf '%s' "$import_forgejo" |
    docker exec -i gnx-garage /garage json-api ImportKey - >/dev/null 2>&1 || true
  printf '%s' '{"globalAlias":"gnx-forgejo","localAlias":null}' |
    docker exec -i gnx-garage /garage json-api CreateBucket - >/dev/null 2>&1 || true
  forgejo_bucket=$(printf '%s' \
    '{"id":null,"globalAlias":"gnx-forgejo","search":null}' |
    docker exec -i gnx-garage /garage json-api GetBucketInfo -)
  forgejo_bucket_id=$(printf '%s' "$forgejo_bucket" |
    jq -er '.id | select(test("^[0-9a-f]{64}$"))')
  allow_forgejo=$(printf \
    '{"bucketId":"%s","accessKeyId":"%s","permissions":{"read":true,"write":true,"owner":true}}' \
    "$forgejo_bucket_id" "$forgejo_access_key")
  printf '%s' "$allow_forgejo" |
    docker exec -i gnx-garage /garage json-api AllowBucketKey - >/dev/null

  unset garage_rpc_secret garage_admin_token tofu_secret_key forgejo_secret_key
  unset import_tofu import_forgejo allow_tofu allow_forgejo
  printf '%s\n' 'GARAGE=ready'
}

write_forgejo_configuration() {
  install_lock=$1
  {
    printf '%s\n' \
      'APP_NAME = GNX Forgejo' \
      'RUN_USER = git' \
      '' \
      '[database]' \
      'DB_TYPE = sqlite3' \
      'PATH = /data/gitea/forgejo.db' \
      '' \
      '[server]'
    printf 'DOMAIN = %s.%s\n' "$hostname" "$tailnet"
    printf 'ROOT_URL = https://%s.%s/\n' "$hostname" "$tailnet"
    printf 'HTTP_PORT = 3000\nSSH_DOMAIN = %s.%s\nSSH_PORT = 2222\n' \
      "$hostname" "$tailnet"
    printf '%s\n' \
      '' \
      '[security]'
    printf 'INSTALL_LOCK = %s\n' "$install_lock"
    printf '%s\n' \
      'SECRET_KEY_URI = file:/run/secrets/forgejo/secret_key' \
      'INTERNAL_TOKEN_URI = file:/run/secrets/forgejo/internal_token' \
      '' \
      '[oauth2]' \
      'JWT_SECRET_URI = file:/run/secrets/forgejo/jwt_secret' \
      '' \
      '[service]' \
      'DISABLE_REGISTRATION = true' \
      '' \
      '[actions]' \
      'ENABLED = true' \
      'DEFAULT_ACTIONS_URL = https://data.forgejo.org/' \
      '' \
      '[storage]' \
      'STORAGE_TYPE = minio'
    printf 'MINIO_ENDPOINT = gnx-garage.%s\n' "$tailnet"
    printf 'MINIO_ACCESS_KEY_ID = %s\n' "$forgejo_s3_access"
    printf 'MINIO_SECRET_ACCESS_KEY = %s\n' "$forgejo_s3_secret"
    printf '%s\n' \
      'MINIO_BUCKET = gnx-forgejo' \
      'MINIO_LOCATION = garage' \
      'MINIO_USE_SSL = true' \
      'MINIO_BUCKET_LOOKUP = path' \
      'MINIO_CHECKSUM_ALGORITHM = default'
  } | write_atomic /var/lib/quetzalcoatl/forgejo/data/gitea/conf/app.ini 0600
  chown 1000:1000 /var/lib/quetzalcoatl/forgejo/data/gitea/conf/app.ini
}

revoke_obsolete_forgejo_tokens() {
  python3 - <<'PY'
import base64
import json
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

lines = Path("/run/gnx/platform-input").read_text(encoding="utf-8").splitlines()
password = lines[10]
authorization = base64.b64encode(f"gnx-admin:{password}".encode("utf-8")).decode("ascii")
base = "http://127.0.0.1:3000/api/v1"

def request(path, method="GET", body=None, accepted=(200,)):
    data = None if body is None else json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        base + path,
        data=data,
        method=method,
        headers={
            "Accept": "application/json",
            "Authorization": f"Basic {authorization}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            if response.status not in accepted:
                raise RuntimeError(f"{path} returned HTTP {response.status}")
            encoded = response.read()
            return json.loads(encoded) if encoded else None
    except urllib.error.HTTPError as error:
        if error.code in accepted:
            return None
        raise

tokens = request("/users/gnx-admin/tokens?limit=100")
for token in tokens:
    name = token.get("name", "")
    if name.startswith(("gnx-platform-reconciler", "gnx-registry-reader")):
        token_id = urllib.parse.quote(str(token["id"]), safe="")
        request(f"/users/gnx-admin/tokens/{token_id}", "DELETE", accepted=(204,))
PY
}

configure_forgejo() {
  stage='forgejo-input'
  IFS= read -r forgejo_s3_access <&3 || exit 64
  IFS= read -r forgejo_s3_secret <&3 || exit 64
  IFS= read -r forgejo_secret_key <&3 || exit 64
  IFS= read -r forgejo_internal_token <&3 || exit 64
  IFS= read -r forgejo_jwt_secret <&3 || exit 64
  IFS= read -r forgejo_admin_password <&3 || exit 64
  IFS= read -r forgejo_runner_secret <&3 || exit 64
  IFS= read -r runner_uuid <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  valid_access_key "$forgejo_s3_access"
  valid_hex "$forgejo_s3_secret" 64
  valid_hex "$forgejo_secret_key" 64
  valid_hex "$forgejo_internal_token" 64
  valid_base64url_32 "$forgejo_jwt_secret"
  valid_hex "$forgejo_admin_password" 48
  valid_hex "$forgejo_runner_secret" 40

  stage='forgejo-assets'
  app_dir='/opt/quetzalcoatl/forgejo'
  install -d -m 0755 "$app_dir" "$app_dir/serve"
  install -d -o 1000 -g 1000 -m 0755 \
    /var/lib/quetzalcoatl/forgejo/data \
    /var/lib/quetzalcoatl/forgejo/data/gitea/conf
  install -d -o 1000 -g 1000 -m 0700 /var/lib/quetzalcoatl/secrets/forgejo
  if [ ! -s /var/lib/quetzalcoatl/secrets/forgejo/secret_key ]; then
    printf '%s\n' "$forgejo_secret_key" |
      write_atomic /var/lib/quetzalcoatl/secrets/forgejo/secret_key 0400
  fi
  if [ ! -s /var/lib/quetzalcoatl/secrets/forgejo/internal_token ]; then
    printf '%s\n' "$forgejo_internal_token" |
      write_atomic /var/lib/quetzalcoatl/secrets/forgejo/internal_token 0400
  fi
  printf '%s' "$forgejo_jwt_secret" |
    write_atomic /var/lib/quetzalcoatl/secrets/forgejo/jwt_secret 0400
  printf '%s' "$forgejo_runner_secret" |
    write_atomic /var/lib/quetzalcoatl/secrets/forgejo/runner_secret 0400
  chown -R 1000:1000 /var/lib/quetzalcoatl/secrets/forgejo

  install_lock=true
  if [ ! -s /var/lib/quetzalcoatl/forgejo/data/gitea/forgejo.db ]; then
    install_lock=false
  fi
  write_forgejo_configuration "$install_lock"
  write_public_environment "$app_dir"
  enroll_tailscale forgejo tag:quetzalcoatl-service
  stage='forgejo-compose'
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing
  constrain_tailscale_mtu gnx-forgejo-tailscale
  if [ "$install_lock" = false ]; then
    wait_http http://127.0.0.1:3000/
  fi

  if [ "$install_lock" = false ]; then
    stage='forgejo-install'
    python3 - <<'PY'
import urllib.parse
import urllib.request
from pathlib import Path

lines = Path("/run/gnx/platform-input").read_text(encoding="utf-8").splitlines()
tailnet, password = lines[3], lines[10]
body = urllib.parse.urlencode({
    "db_type": "sqlite3",
    "db_path": "/data/gitea/forgejo.db",
    "app_name": "GNX Forgejo",
    "repo_root_path": "/data/git/repositories",
    "lfs_root_path": "/data/gitea/lfs",
    "run_user": "git",
    "domain": f"gnx-forgejo.{tailnet}",
    "ssh_port": "2222",
    "http_port": "3000",
    "app_url": f"https://gnx-forgejo.{tailnet}/",
    "log_root_path": "/data/gitea/log",
    "disable_registration": "on",
    "offline_mode": "on",
    "disable_gravatar": "on",
    "admin_name": "gnx-admin",
    "admin_passwd": password,
    "admin_confirm_passwd": password,
    "admin_email": "gnx-admin@example.invalid",
}).encode()
request = urllib.request.Request(
    "http://127.0.0.1:3000/", data=body, method="POST",
    headers={"Content-Type": "application/x-www-form-urlencoded"},
)
with urllib.request.urlopen(request, timeout=30) as response:
    if response.status not in (200, 302):
        raise RuntimeError(f"Forgejo installer returned HTTP {response.status}")
PY
    write_forgejo_configuration true
    docker restart gnx-forgejo >/dev/null
  else
    docker restart gnx-forgejo >/dev/null
  fi
  stage='forgejo-health'
  wait_http http://127.0.0.1:3000/api/healthz

  stage='forgejo-obsolete-token-revocation'
  revoke_obsolete_forgejo_tokens

  stage='forgejo-runner-registration'
  if [ -z "$runner_uuid" ]; then
    runner_output=$(docker exec --user git gnx-forgejo \
      forgejo forgejo-cli actions register \
      --secret-file /run/secrets/forgejo/runner_secret \
      --name gnx-runner \
      --labels docker,ubuntu-latest:docker://data.forgejo.org/oci/node:24-trixie)
    runner_uuid=$(printf '%s\n' "$runner_output" | tail -n 1)
    unset runner_output
  fi
  printf '%s\n' "$runner_uuid" |
    grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  printf 'FORGEJO_RUNNER_UUID=%s\n' "$runner_uuid"
  printf '%s\n' 'FORGEJO=ready'
}

configure_runner() {
  stage='runner-input'
  IFS= read -r runner_uuid <&3 || exit 64
  IFS= read -r runner_secret <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  case "$runner_uuid" in ''|*[!A-Za-z0-9._-]*) exit 64 ;; esac
  valid_hex "$runner_secret" 40

  stage='runner-assets'
  app_dir='/opt/quetzalcoatl/runner'
  install -d -m 0700 "$app_dir" /var/lib/quetzalcoatl/runner
  write_public_environment "$app_dir"
  {
    printf '%s\n' \
      'log:' \
      '  level: info' \
      'runner:' \
      '  file: /data/.runner' \
      '  capacity: 1' \
      '  timeout: 3h' \
      '  labels:' \
      '    - docker' \
      '    - ubuntu-latest:docker://data.forgejo.org/oci/node:24-trixie' \
      'container:' \
      '  network: container:gnx-runner-tailscale' \
      '  docker_host: unix:///var/run/docker.sock' \
      'cache:' \
      '  enabled: true' \
      '  dir: /data/cache' \
      'server:' \
      '  connections:' \
      '    forgejo:'
    printf '      url: https://gnx-forgejo.%s/\n' "$tailnet"
    printf '      uuid: %s\n' "$runner_uuid"
    printf '      token: %s\n' "$runner_secret"
  } | write_atomic /var/lib/quetzalcoatl/runner/runner-config.yml 0600
  enroll_tailscale runner tag:quetzalcoatl-service
  stage='runner-compose'
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing --wait --wait-timeout 300
  constrain_tailscale_mtu gnx-runner-tailscale
  test "$(docker inspect --format '{{.State.Running}}' gnx-runner)" = true
  printf '%s\n' 'RUNNER=ready'
}

configure_service() {
  IFS= read -r slug <&3 || exit 64
  IFS= read -r tag <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  case "$slug" in freellmapi-1|omniroute-1|deepseek-dsh-1) ;; *) exit 64 ;; esac
  case "$tag" in tag:quetzalcoatl-[a-z0-9][a-z0-9-]*) ;; *) exit 64 ;; esac
  [ "${#tag}" -le 48 ]

  app_dir="/opt/quetzalcoatl/services/$slug"
  install -d -m 0755 "$app_dir" "$app_dir/serve"
  install -d -m 0700 /var/lib/quetzalcoatl/secrets
  write_public_environment "$app_dir"
  printf 'GNX_CONTAINER_PREFIX=gnx-service-%s\n' "$slug" >> "$app_dir/.env"
  if [ "$slug" = freellmapi-1 ]; then
    encryption_key=/var/lib/quetzalcoatl/secrets/freellmapi-encryption-key
    if [ ! -s "$encryption_key" ]; then
      umask 077
      od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$encryption_key.gnx-new"
      test "$(wc -c < "$encryption_key.gnx-new")" -eq 64
      mv -f "$encryption_key.gnx-new" "$encryption_key"
    fi
    printf 'ENCRYPTION_KEY=%s\n' "$(cat "$encryption_key")" >> "$app_dir/.env"
  fi
  chmod 0600 "$app_dir/.env"
  enroll_tailscale "service-$slug" "$tag"
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing --wait --wait-timeout 300
  constrain_tailscale_mtu "gnx-service-$slug-tailscale"
  printf '%s\n' 'SERVICE=ready'
}

case "$kind" in
  garage) configure_garage ;;
  forgejo) configure_forgejo ;;
  runner) configure_runner ;;
  service) configure_service ;;
  *) exit 64 ;;
esac

stage='ready'
exec 3<&-
unset auth_key
trap - EXIT HUP INT TERM
rm -f -- "$auth_file" "$status_file" "$status_file.gnx-new" "$input"
