for path, content in files.items():
    quoted = urllib.parse.quote(path, safe="/")
    status, _ = request(
        f"/api/v1/repos/gnx-labs/gnx-service-template/contents/{quoted}",
        accepted=(200, 404),
    )
    if status == 404:
        request(
            f"/api/v1/repos/gnx-labs/gnx-service-template/contents/{quoted}",
            "POST",
            {
                "branch": "main",
                "message": f"Initialize {path}",
                "content": base64.b64encode(content.encode()).decode(),
            },
            (201,),
        )
PY
}

reconcile_forgejo_tokens() {
  python3 - <<'PY'
import base64
import json
import re
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

lines = Path("/run/gnx/platform-input").read_text(encoding="utf-8").splitlines()
password = lines[10]
authorization = base64.b64encode(f"gnx-admin:{password}".encode("utf-8")).decode("ascii")
base = "http://127.0.0.1:3000/api/v1"

def request(path, method="GET", body=None, accepted=(200,)):
    data = None if body is None else json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        base + path,
        data=data,
        method=method,
        headers={
            "Accept": "application/json",
            "Authorization": f"Basic {authorization}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            if response.status not in accepted:
                raise RuntimeError(f"{path} returned HTTP {response.status}")
            encoded = response.read()
            return json.loads(encoded) if encoded else None
    except urllib.error.HTTPError as error:
        if error.code in accepted:
            return None
        raise

tokens = request("/users/gnx-admin/tokens?limit=100")
for token in tokens:
    name = token.get("name", "")
    if name.startswith(("gnx-platform-reconciler", "gnx-registry-reader")):
        token_id = urllib.parse.quote(str(token["id"]), safe="")
        request(f"/users/gnx-admin/tokens/{token_id}", "DELETE", accepted=(204,))

def create(name, scopes):
    token = request(
        "/users/gnx-admin/tokens",
        "POST",
        {"name": name, "scopes": scopes},
        accepted=(201,),
    )
    value = token.get("sha1", "")
    if re.fullmatch(r"[0-9a-f]{40}", value) is None:
        raise RuntimeError("Forgejo returned an invalid access token")
    return value

print(create("gnx-platform-reconciler", ["all"]))
print(create("gnx-registry-reader", ["read:package"]))
PY
}

configure_forgejo() {
  stage='forgejo-input'
  IFS= read -r forgejo_s3_access <&3 || exit 64
  IFS= read -r forgejo_s3_secret <&3 || exit 64
  IFS= read -r forgejo_secret_key <&3 || exit 64
  IFS= read -r forgejo_internal_token <&3 || exit 64
  IFS= read -r forgejo_jwt_secret <&3 || exit 64
  IFS= read -r forgejo_admin_password <&3 || exit 64
  IFS= read -r forgejo_runner_secret <&3 || exit 64
  IFS= read -r platform_api_token <&3 || exit 64
  IFS= read -r registry_reader_token <&3 || exit 64
  IFS= read -r runner_uuid <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  valid_access_key "$forgejo_s3_access"
  valid_hex "$forgejo_s3_secret" 64
  valid_hex "$forgejo_secret_key" 64
  valid_hex "$forgejo_internal_token" 64
  valid_base64url_32 "$forgejo_jwt_secret"
  valid_hex "$forgejo_admin_password" 48
  valid_hex "$forgejo_runner_secret" 40

  stage='forgejo-assets'
  app_dir='/opt/quetzalcoatl/forgejo'
  install -d -m 0755 "$app_dir" "$app_dir/serve"
  install -d -o 1000 -g 1000 -m 0755 \
    /var/lib/quetzalcoatl/forgejo/data \
    /var/lib/quetzalcoatl/forgejo/data/gitea/conf
  install -d -o 1000 -g 1000 -m 0700 /var/lib/quetzalcoatl/secrets/forgejo
  if [ ! -s /var/lib/quetzalcoatl/secrets/forgejo/secret_key ]; then
    printf '%s\n' "$forgejo_secret_key" |
      write_atomic /var/lib/quetzalcoatl/secrets/forgejo/secret_key 0400
  fi
  if [ ! -s /var/lib/quetzalcoatl/secrets/forgejo/internal_token ]; then
    printf '%s\n' "$forgejo_internal_token" |
      write_atomic /var/lib/quetzalcoatl/secrets/forgejo/internal_token 0400
  fi
  printf '%s' "$forgejo_jwt_secret" |
    write_atomic /var/lib/quetzalcoatl/secrets/forgejo/jwt_secret 0400
  printf '%s' "$forgejo_runner_secret" |
    write_atomic /var/lib/quetzalcoatl/secrets/forgejo/runner_secret 0400
  chown -R 1000:1000 /var/lib/quetzalcoatl/secrets/forgejo

  install_lock=true
  if [ ! -s /var/lib/quetzalcoatl/forgejo/data/gitea/forgejo.db ]; then
    install_lock=false
  fi
  write_forgejo_configuration "$install_lock"
  write_public_environment "$app_dir"
  enroll_tailscale forgejo
  stage='forgejo-compose'
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing
  constrain_tailscale_mtu gnx-forgejo-tailscale
  if [ "$install_lock" = false ]; then
    wait_http http://127.0.0.1:3000/
  fi

  if [ "$install_lock" = false ]; then
    stage='forgejo-install'
    python3 - <<'PY'
import urllib.parse
import urllib.request
from pathlib import Path

lines = Path("/run/gnx/platform-input").read_text(encoding="utf-8").splitlines()
tailnet, password = lines[3], lines[10]
body = urllib.parse.urlencode({
    "db_type": "sqlite3",
    "db_path": "/data/gitea/forgejo.db",
    "app_name": "GNX Forgejo",
    "repo_root_path": "/data/git/repositories",
    "lfs_root_path": "/data/gitea/lfs",
    "run_user": "git",
    "domain": f"gnx-forgejo.{tailnet}",
    "ssh_port": "2222",
    "http_port": "3000",
    "app_url": f"https://gnx-forgejo.{tailnet}/",
    "log_root_path": "/data/gitea/log",
    "disable_registration": "on",
    "offline_mode": "on",
    "disable_gravatar": "on",
    "admin_name": "gnx-admin",
    "admin_passwd": password,
    "admin_confirm_passwd": password,
    "admin_email": "gnx-admin@example.invalid",
}).encode()
request = urllib.request.Request(
    "http://127.0.0.1:3000/", data=body, method="POST",
    headers={"Content-Type": "application/x-www-form-urlencoded"},
)
with urllib.request.urlopen(request, timeout=30) as response:
    if response.status not in (200, 302):
        raise RuntimeError(f"Forgejo installer returned HTTP {response.status}")
PY
    write_forgejo_configuration true
    docker restart gnx-forgejo >/dev/null
  else
    docker restart gnx-forgejo >/dev/null
  fi
  stage='forgejo-health'
  wait_http http://127.0.0.1:3000/api/healthz

  stage='forgejo-api-token'
  if [ -z "$platform_api_token" ] || [ -z "$registry_reader_token" ]; then
    generated_tokens=$(reconcile_forgejo_tokens)
    [ "$(printf '%s\n' "$generated_tokens" | wc -l)" -eq 2 ]
    platform_api_token=$(printf '%s\n' "$generated_tokens" | sed -n '1p')
    registry_reader_token=$(printf '%s\n' "$generated_tokens" | sed -n '2p')
    unset generated_tokens
  fi
  valid_hex "$platform_api_token" 40
  valid_hex "$registry_reader_token" 40
  printf 'FORGEJO_API_TOKEN=%s\n' "$platform_api_token"
  printf 'FORGEJO_REGISTRY_TOKEN=%s\n' "$registry_reader_token"
  printf '%s\n' "$platform_api_token" > /run/gnx/forgejo-api-token
  chmod 0400 /run/gnx/forgejo-api-token
  stage='forgejo-api-bootstrap'
  configure_forgejo_api
  rm -f /run/gnx/forgejo-api-token

  stage='forgejo-runner-registration'
  if [ -z "$runner_uuid" ]; then
    runner_output=$(docker exec --user git gnx-forgejo \
      forgejo forgejo-cli actions register \
      --secret-file /run/secrets/forgejo/runner_secret \
      --name gnx-runner \
      --labels docker,ubuntu-latest:docker://data.forgejo.org/oci/node:24-trixie)
    runner_uuid=$(printf '%s\n' "$runner_output" | tail -n 1)
    unset runner_output
  fi
  printf '%s\n' "$runner_uuid" |
    grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  printf 'FORGEJO_RUNNER_UUID=%s\n' "$runner_uuid"
  printf '%s\n' 'FORGEJO=ready'
}

configure_runner() {
  stage='runner-input'
  IFS= read -r runner_uuid <&3 || exit 64
  IFS= read -r runner_secret <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  case "$runner_uuid" in ''|*[!A-Za-z0-9._-]*) exit 64 ;; esac
  valid_hex "$runner_secret" 40

  stage='runner-assets'
  app_dir='/opt/quetzalcoatl/runner'
  install -d -m 0700 "$app_dir" /var/lib/quetzalcoatl/runner
  write_public_environment "$app_dir"
  {
    printf '%s\n' \
      'log:' \
      '  level: info' \
      'runner:' \
      '  file: /data/.runner' \
      '  capacity: 1' \
      '  timeout: 3h' \
      '  labels:' \
      '    - docker' \
      '    - ubuntu-latest:docker://data.forgejo.org/oci/node:24-trixie' \
      'container:' \
      '  network: container:gnx-runner-tailscale' \
      '  docker_host: unix:///var/run/docker.sock' \
      'cache:' \
      '  enabled: true' \
      '  dir: /data/cache' \
      'server:' \
      '  connections:' \
      '    forgejo:'
    printf '      url: https://gnx-forgejo.%s/\n' "$tailnet"
    printf '      uuid: %s\n' "$runner_uuid"
    printf '      token: %s\n' "$runner_secret"
  } | write_atomic /var/lib/quetzalcoatl/runner/runner-config.yml 0600
  enroll_tailscale runner
  stage='runner-compose'
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing --wait --wait-timeout 300
  constrain_tailscale_mtu gnx-runner-tailscale
  test "$(docker inspect --format '{{.State.Running}}' gnx-runner)" = true
  printf '%s\n' 'RUNNER=ready'
}

configure_service() {
  IFS= read -r slug <&3 || exit 64
  IFS= read -r image <&3 || exit 64
  IFS= read -r registry_token <&3 || exit 64
  if IFS= read -r extra <&3; then exit 64; fi
  case "$slug" in ''|*[!a-z0-9-]*|*-*) exit 64 ;; esac
  [ "${#slug}" -le 32 ]
  case "$image" in
    "gnx-forgejo.$tailnet/gnx-labs/"*"@sha256:"????????????????????????????????????????????????????????????????) ;;
    *) exit 64 ;;
  esac
  [ "${#registry_token}" -ge 20 ] && [ "${#registry_token}" -le 512 ]

  app_dir="/opt/quetzalcoatl/services/$slug"
  install -d -m 0755 "$app_dir" "$app_dir/serve"
  write_public_environment "$app_dir"
  {
    printf 'GNX_CONTAINER_PREFIX=gnx-service-%s\n' "$slug"
    printf 'GNX_IMAGE=%s\n' "$image"
  } >> "$app_dir/.env"
  chmod 0600 "$app_dir/.env"
  printf '%s' "$registry_token" |
    docker login "gnx-forgejo.$tailnet" \
      --username gnx-admin --password-stdin >/dev/null
  enroll_tailscale service
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" config --quiet
  docker compose --project-directory "$app_dir" --env-file "$app_dir/.env" \
    -f "$app_dir/compose.yml" up --detach --pull missing --wait --wait-timeout 300
  constrain_tailscale_mtu "gnx-service-$slug-tailscale"
  printf '%s\n' 'SERVICE=ready'
}

case "$kind" in
  garage) configure_garage ;;
  forgejo) configure_forgejo ;;
  runner) configure_runner ;;
  service) configure_service ;;
  *) exit 64 ;;
esac

stage='ready'
exec 3<&-
unset auth_key
trap - EXIT HUP INT TERM
rm -f -- "$auth_file" "$status_file" "$status_file.gnx-new" "$input"
