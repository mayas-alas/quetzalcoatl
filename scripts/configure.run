#!/usr/bin/bash
# Fixed secret consumers. Input arrives through inherited stdin, never argv.
set -euo pipefail
umask 077
[[ $(id -u) == 0 ]]
systemctl is-active --quiet gnx-core.target
IFS= read -r secret
[[ -n "$secret" && ${#secret} -le 1024 ]]
case ${1:-} in
  mesh)
    temporary=$(mktemp -d /run/gnx-core-secret.XXXXXX)
    trap 'rm -f -- "$temporary/key"; rmdir -- "$temporary"' EXIT
    printf '%s' "$secret" > "$temporary/key"
    unset secret
    podman cp "$temporary/key" gnx-core-mesh:/run/gnx-auth-key >/dev/null 2>&1
    trap 'podman exec gnx-core-mesh rm -f /run/gnx-auth-key >/dev/null 2>&1 || :; rm -f -- "$temporary/key"; rmdir -- "$temporary"' EXIT
    podman exec gnx-core-mesh chmod 0600 /run/gnx-auth-key >/dev/null 2>&1
    podman exec gnx-core-mesh tailscale up --auth-key=file:/run/gnx-auth-key --accept-dns=false --timeout=120s >/dev/null 2>&1
    mesh_ip=$(podman exec gnx-core-mesh tailscale ip -4 | head -n 1)
    [[ "$mesh_ip" =~ ^100\.[0-9]+\.[0-9]+\.[0-9]+$ ]]
    printf 'FTLCONF_dns_interface=tailscale0\nFTLCONF_dns_port=53\nFTLCONF_dns_listeningMode=NONE\nFTLCONF_misc_dnsmasq_lines=interface=tailscale0;except-interface=lo;bind-dynamic\nFTLCONF_dns_hosts=%s app.gnx;%s compute.gnx\n' "$mesh_ip" "$mesh_ip" > /var/lib/gnx-core/dns.env
    chmod 0644 /var/lib/gnx-core/dns.env
    systemctl restart gnx-core-dns.service >/dev/null 2>&1
    bind=$(ip -4 -o addr show dev eth0 | awk '{split($4,a,"/"); print a[1]; exit}')
    printf 'GNX_BIND=%s %s\n' "$bind" "$mesh_ip" > /var/lib/gnx-core/gateway.env
    systemctl restart gnx-core-gateway.service >/dev/null 2>&1
    printf '%s\n' "DNS configurado en $mesh_ip. Split DNS pendiente en Tailscale; resolución remota y confianza CA pendientes." > /var/lib/gnx-core/web/status.new
    chmod 0644 /var/lib/gnx-core/web/status.new
    mv /var/lib/gnx-core/web/status.new /var/lib/gnx-core/web/status.txt
    ;;
  compute)
    [[ ${#secret} -ge 12 && "$secret" != root ]]
    hash=$(printf '%s' "$secret" | openssl passwd -6 -stdin)
    unset secret
    printf 'PASSWORD_HASH=%s\n' "$hash" > /var/lib/gnx-core/secrets/compute.env.new
    chmod 0600 /var/lib/gnx-core/secrets/compute.env.new
    mv /var/lib/gnx-core/secrets/compute.env.new /var/lib/gnx-core/secrets/compute.env
    if systemctl is-active --quiet gnx-core-compute.service; then
      printf 'root:%s\n' "$hash" | podman exec -i gnx-core-compute chpasswd -e >/dev/null 2>&1
    else
      systemctl start gnx-core-compute.service
    fi
    unset hash
    printf '%s\n' 'Compute iniciado; comprobar HTTPS y autenticación nativa.' > /var/lib/gnx-core/web/status.txt
    ;;
  *) exit 64 ;;
esac
chmod 0644 /var/lib/gnx-core/web/status.txt
