#!/usr/bin/bash
# Fixed offline provisioning; systemd owns lifecycle.
set -euo pipefail
umask 077
payload=${1:?payload directory required}
mode=${2:-install}
[[ "$mode" == install || "$mode" == update ]]
root=/var/lib/gnx-core
[[ $(id -u) == 0 && -f "$payload/config/images.json" ]]
if [[ "$mode" == update ]]; then [[ -f "$root/ca-private/root.key" && -f "$root/tls/root.crt" ]]; fi
for cmd in podman systemctl openssl jq ip; do command -v "$cmd" >/dev/null; done
install -d -m 0700 "$root" "$root/secrets" "$root/tls" "$root/ca-private" "$root/mesh" "$root/dns" "$root/compute" "$root/compute-config" "$root/gateway-data" "$root/gateway-config"
install -d -m 0755 /etc/gnx-core "$root/web" /etc/containers/systemd
install -m 0644 "$payload/config/web/index.html" "$root/web/index.html"
phase() { printf '%s\n' "$1" > "$root/web/status.new"; chmod 0644 "$root/web/status.new"; mv "$root/web/status.new" "$root/web/status.txt"; }
phase 'Preparando acceso local; mesh y compute no condicionan esta página.'
bash "$payload/scripts/tls.run" prepare "$payload"
install -m 0644 "$payload/config/gateway/Caddyfile" /etc/gnx-core/Caddyfile
install -m 0644 "$payload/config/compute/pveproxy.conf" /etc/gnx-core/pveproxy.conf
install -m 0755 "$payload/scripts/install-pve-tls.run" /etc/gnx-core/install-pve-tls.run
install -m 0755 "$payload/scripts/configure.run" /etc/gnx-core/configure.run
install -m 0755 "$payload/scripts/stack-access.run" /etc/gnx-core/stack-access.run
install -m 0644 "$payload/config/compute/stack-dns.conf" /etc/gnx-core/stack-dns.conf
install -m 0644 "$payload/config/gateway/private-stack.caddy" /etc/gnx-core/private-stack.caddy
install -d -m 0755 "$root/stack-dns" "$root/stack-gateway"
if [[ ! -e "$root/stack-dns/hosts.conf" ]]; then printf '# No private stack registered.\n' > "$root/stack-dns/hosts.conf"; fi
chmod 0644 "$root/stack-dns/hosts.conf"
install -m 0644 "$payload/config/systemd/gnx-core.target" /etc/systemd/system/gnx-core.target
chmod 0755 /etc/containers/systemd
install -m 0644 "$payload/config/quadlet/"*.container /etc/containers/systemd/
bash /etc/gnx-core/configure.run access
if [[ ! -f "$root/dns.env" ]]; then
    printf 'FTLCONF_dns_interface=lo\nFTLCONF_dns_port=5353\nFTLCONF_dns_listeningMode=BIND\nFTLCONF_dns_hosts=127.0.0.1 app.gnx;127.0.0.1 compute.gnx\n' > "$root/dns.env"
fi
chmod 0644 "$root/dns.env"
systemctl daemon-reload
for role in gateway dns mesh compute; do
    phase "Cargando imagen local: $role. Sin descargas de instalación."
    id=$(jq -er --arg role "$role" '.[$role].id' "$payload/config/images.json")
    if ! podman image exists "$id"; then podman load -i "$payload/images/$role.oci.tar" >/dev/null; fi
    podman image exists "$id"
    if [[ "$mode" == install && "$role" == dns ]]; then systemctl start gnx-core-gateway.service gnx-core-dns.service; fi
done
systemctl daemon-reload
systemctl enable gnx-core-crl.timer
if [[ "$mode" == install ]]; then
    systemctl start gnx-core.target
elif systemctl is-active --quiet gnx-core.target; then
    systemctl start gnx-core-crl.timer
    systemctl --no-block try-restart gnx-core-mesh.service
    systemctl try-restart gnx-core-compute.service gnx-core-dns.service gnx-core-gateway.service
fi
install -m 0644 "$root/tls/root.crt" "$root/web/gnx-labs-root.crt"
chmod 0644 "$root/web/gnx-labs-root.crt"
phase 'Configuración aplicada. Consulta gnx status; diagnóstico en journal/Visor de eventos.'
