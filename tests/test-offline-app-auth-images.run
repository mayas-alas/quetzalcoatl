#!/usr/bin/env bash
# Isolated store catches pins that only appear to work in a contaminated store.
set -Eeuo pipefail
[[ $(id -u) == 0 ]] || exit 64
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
base="$root/payload/node/auth"
(cd "$base" && sha256sum --check offline.sha256)
args=(--root /var/lib/gnx-build-validation/app-auth-images --runroot /run/gnx-build-validation-app-auth-images --storage-driver vfs)
for pair in 'app-auth oauth2-proxy' 'app-sessions valkey'; do
  read -r unit member <<< "$pair"
  tar -xOzf "$base/offline.tar.gz" "$member.tar" | podman "${args[@]}" load >/dev/null
  ref=$(awk -F= '$1 == "Image" {print $2}' "$root/payload/node/services/$unit.container")
  podman "${args[@]}" image exists "$ref" || { echo APP_AUTH_OFFLINE_PIN_MISMATCH >&2; exit 1; }
  printf 'offline app auth pin verified: %s\n' "$unit"
done
