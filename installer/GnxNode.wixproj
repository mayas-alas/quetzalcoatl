<Project Sdk="WixToolset.Sdk/5.0.2"><PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutputName>GnxNode</OutputName><HostAgentExe>$(MSBuildProjectDirectory)\..\target\release\gnx-host-agent.exe</HostAgentExe><SetupExe>$(MSBuildProjectDirectory)\..\target\release\gnx-setup.exe</SetupExe><HostPayload>$(MSBuildProjectDirectory)\..\payload\host</HostPayload><NodePayload>$(MSBuildProjectDirectory)\..\build\payload\node</NodePayload><DefineConstants>HostAgentExe=$(HostAgentExe);SetupExe=$(SetupExe);HostPayload=$(HostPayload);NodePayload=$(NodePayload)</DefineConstants></PropertyGroup><ItemGroup><Compile Include="Product.wxs" /></ItemGroup></Project>
