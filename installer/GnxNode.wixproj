<Project Sdk="WixToolset.Sdk/5.0.2"><PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutputName>GnxNode</OutputName><HostAgentExe>$(MSBuildProjectDirectory)\..\target\release\gnx-host-agent.exe</HostAgentExe><SetupExe>$(MSBuildProjectDirectory)\..\target\release\gnx.exe</SetupExe><HostPayload>$(MSBuildProjectDirectory)\..\payload\host</HostPayload><NodePayload>$(MSBuildProjectDirectory)\..\build\payload\node</NodePayload><LicenseFile>$(MSBuildProjectDirectory)\..\LICENSE</LicenseFile><DefineConstants>LicenseFile=$(LicenseFile);HostAgentExe=$(HostAgentExe);SetupExe=$(SetupExe);HostPayload=$(HostPayload);NodePayload=$(NodePayload)</DefineConstants></PropertyGroup><ItemGroup><Compile Include="Product.wxs" /><PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" /></ItemGroup></Project>
