<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputName>GnxCore</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-us</Cultures>
    <GnxVersion Condition="'$(GnxVersion)' == ''">0.0.1</GnxVersion>
    <GnxPayload Condition="'$(GnxPayload)' == ''">$(MSBuildProjectDirectory)\..\build\package\v$(GnxVersion)\payload</GnxPayload>
    <DefineConstants>Binary=$(MSBuildProjectDirectory)\..\target\release\gnx.exe;Payload=$(GnxPayload);Version=$(GnxVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
