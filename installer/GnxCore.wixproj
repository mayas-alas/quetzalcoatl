<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputName>GnxCore</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Binary=$(MSBuildProjectDirectory)\..\target\release\gnx.exe;Payload=$(MSBuildProjectDirectory)\..\build\package\payload</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
