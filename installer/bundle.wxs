<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
    Name="Quetzalcoatl"
    Manufacturer="Quetzalcoatl"
    Version="0.1.15"
    ProviderKey="{10B764B2-36AE-4911-A8C8-2F1A2A963769}"
    UpgradeCode="{10B764B2-36AE-4911-A8C8-2F1A2A963769}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl="" />
    </BootstrapperApplication>

    <Chain>
      <ExePackage
        Id="PrepareWsl"
        SourceFile="$(var.HostPreflight)"
        Name="gnx-host-prepare.exe"
        CacheId="gnx-host-prepare-0.1.15"
        DetectCondition="0"
        InstallArguments="prepare-wsl --format json"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="14" Behavior="forceReboot" />
        <ExitCode Value="3010" Behavior="forceReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <!-- WSL and Podman are ancillary payloads of typed helpers. The helpers
           copy them into the GNX-owned ProgramData cache, validate size and
           SHA-256, and only then invoke msiexec from the stable path. -->
      <ExePackage
        Id="InstallWsl"
        SourceFile="$(var.HostPreflight)"
        Name="gnx-host-install-wsl.exe"
        CacheId="gnx-host-install-wsl-0.1.15"
        DetectCondition="0"
        InstallArguments="install-wsl --format json"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes">
        <Payload
          Id="WslMsiPayload"
          SourceFile="$(var.WslMsi)"
          Name="wsl.2.7.10.0.x64.msi"
          Compressed="yes" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="1641" Behavior="forceReboot" />
        <ExitCode Value="3010" Behavior="forceReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <ExePackage
        Id="InstallPodman"
        SourceFile="$(var.HostPreflight)"
        Name="gnx-host-install-podman.exe"
        CacheId="gnx-host-install-podman-0.1.15"
        DetectCondition="0"
        InstallArguments="install-podman --format json"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes">
        <Payload
          Id="PodmanMsiPayload"
          SourceFile="$(var.PodmanMsi)"
          Name="podman-installer-windows-amd64.msi"
          Compressed="yes" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="1641" Behavior="forceReboot" />
        <ExitCode Value="3010" Behavior="forceReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <ExePackage
        Id="ValidateHost"
        SourceFile="$(var.HostPreflight)"
        Name="gnx-host-validate.exe"
        CacheId="gnx-host-validate-0.1.15"
        DetectCondition="0"
        InstallArguments="--format json"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="14" Behavior="forceReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
        Id="QuetzalcoatlProduct"
        SourceFile="$(var.ProductMsi)"
        Compressed="yes"
        Visible="yes"
        Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
