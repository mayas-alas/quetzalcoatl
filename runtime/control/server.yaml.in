server:
  listenAddress: ":80"
  exposedAddress: "https://mesh.gnx:443"
  stunPorts: [3478]
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "error"
  logFile: "console"
  authSecret: "__RELAY_SECRET__"
  dataDir: "/var/lib/netbird"
  disableAnonymousMetrics: true
  disableGeoliteUpdate: true
  auth:
    issuer: "https://mesh.gnx/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "__COOKIE_KEY__"
    dashboardRedirectURIs:
      - "https://mesh.gnx/nb-auth"
      - "https://mesh.gnx/nb-silent-auth"
    cliRedirectURIs: ["http://localhost:53000/"]
  store:
    engine: "sqlite"
    encryptionKey: "__STORE_KEY__"
