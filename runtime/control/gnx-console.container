[Unit]
Description=GNX operator console (upstream attribution retained)

[Container]
Image=docker.io/netbirdio/dashboard@sha256:f3eb26c93ca9901a7385e88e12f6ad98d04e075e8817c664d73557fea123875f
ContainerName=gnx-console
Network=gnx-control.network
EnvironmentFile=/var/lib/gnx/control/console.env
LogDriver=none

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
