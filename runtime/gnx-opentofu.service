[Unit]
Description=GNX fixed bootstrap for the OpenTofu LXC runner
After=network-online.target proxmox.service
Requires=proxmox.service
ConditionPathIsExecutable=/opt/gnx/guest/infra-runner-bootstrap.sh
ConditionPathExists=/opt/gnx/guest/opentofu.tar.gz

[Service]
Type=oneshot
ExecStartPre=/usr/bin/podman wait --condition=healthy --interval=5s gnx-proxmox
ExecStart=/usr/bin/podman exec gnx-proxmox /opt/gnx/guest/infra-runner-bootstrap.sh
TimeoutStartSec=30min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
