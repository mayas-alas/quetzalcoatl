#!/bin/sh
set -eu
umask 077
export LC_ALL=C

runtime_dir='/run/gnx/forgejo-configure'
input="$runtime_dir/input"
guest_input='/run/gnx/forgejo-configure.input'
guest_script='/run/gnx/forgejo-configure'
vmid=201
host_stage='INPUT_CAPTURE'

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$input"
  rmdir "$runtime_dir" >/dev/null 2>&1 || true
  pct exec "$vmid" -- rm -f "$guest_input" "$guest_script" >/dev/null 2>&1 || true
  if [ "$result" -ne 0 ]; then
    printf 'FORGEJO_HOST_STAGE=%s\n' "$host_stage" >&2
  fi
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

install -d -m 0700 "$runtime_dir"
cat > "$input"
chmod 0400 "$input"
host_stage='INPUT_VALIDATION'
test "$(stat -c '%u:%g:%a' "$input")" = '0:0:400'

line_count=$(wc -l < "$input")
[ "$line_count" -eq 4 ]
test -x /usr/libexec/quetzalcoatl/gnx-forgejo-configure-guest
test -s "/etc/pve/lxc/$vmid.conf"
host_stage='LXC_AVAILABILITY'
pct status "$vmid" | grep -q 'status: running'

host_stage='GUEST_STAGING'
pct push "$vmid" "$input" "$guest_input" --perms 0400 >/dev/null
pct push "$vmid" /usr/libexec/quetzalcoatl/gnx-forgejo-configure-guest "$guest_script" --perms 0700 >/dev/null
host_stage='GUEST_EXECUTION'
set +e
output=$(pct exec "$vmid" -- "$guest_script" 2>/dev/null)
guest_status=$?
set -e
if [ "$guest_status" -ne 0 ]; then
  guest_stage=$(printf '%s\n' "$output" |
    sed -n 's/^FORGEJO_GUEST_STAGE=\([A-Z_]*\)$/\1/p' |
    tail -n 1)
  case "$guest_stage" in
    INPUT_VALIDATION|CONTAINER_DISCOVERY|CURRENT_AUTHENTICATION|USER_LOOKUP|USER_CREATION|ADMIN_PROMOTION|PROMOTED_VERIFICATION|PREVIOUS_ADMIN_DISABLE|FINAL_VERIFICATION)
      host_stage="GUEST_$guest_stage"
      ;;
    *) host_stage='GUEST_UNCLASSIFIED' ;;
  esac
  exit 75
fi

host_stage='CLEANUP_VERIFICATION'
rm -f "$input"
pct exec "$vmid" -- rm -f "$guest_input" "$guest_script" >/dev/null
test ! -e "$input"
host_stage='RUNTIME_DIRECTORY_CLEANUP'
rmdir "$runtime_dir"
host_stage='OUTPUT_VERIFICATION'
[ "$output" = 'FORGEJO_CONFIGURATION=ready' ]
trap - EXIT HUP INT TERM
printf '%s\n' "$output"
