#!/bin/sh
set -eu
umask 077
export LC_ALL=C
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

input='/run/gnx/forgejo-configure.input'
curl_config='/run/gnx/forgejo-configure.curl'
request='/run/gnx/forgejo-configure.json'
response='/run/gnx/forgejo-configure.response'

cleanup() {
  rm -f "$input" "$curl_config" "$request" "$response"
}
trap cleanup EXIT HUP INT TERM

exec 3< "$input"
IFS= read -r current_username <&3 || exit 64
IFS= read -r current_password <&3 || exit 64
IFS= read -r new_username <&3 || exit 64
IFS= read -r new_password <&3 || exit 64
if IFS= read -r extra <&3; then
  exit 64
fi
exec 3<&-

valid_username() {
  value=$1
  [ -n "$value" ] && [ "${#value}" -le 40 ] || return 1
  case "$value" in [-_.]*|*[-_.]|*[!A-Za-z0-9_.-]*) return 1 ;; esac
}
valid_password() {
  value=$1
  [ "${#value}" -ge 12 ] && [ "${#value}" -le 128 ] || return 1
  case "$value" in *[![:graph:]]*) return 1 ;; esac
}
valid_username "$current_username"
valid_username "$new_username"
valid_password "$current_password"
valid_password "$new_password"

application_pid=$(docker inspect --format '{{.State.Pid}}' gnx-forgejo)
case "$application_pid" in ''|0|*[!0-9]*) exit 69 ;; esac
in_service_netns() {
  nsenter --target "$application_pid" --net -- "$@"
}
write_auth_config() {
  username=$1
  password=$2
  authorization=$(printf '%s:%s' "$username" "$password" | base64 | tr -d '\r\n')
  printf 'silent\nshow-error\nfail\nheader = "Authorization: Basic %s"\nheader = "Content-Type: application/json"\n' \
    "$authorization" > "$curl_config"
  chmod 0400 "$curl_config"
}
probe_new_login() {
  write_auth_config "$new_username" "$new_password"
  if in_service_netns curl --config "$curl_config" \
    --output "$response" \
    'http://127.0.0.1:3000/api/v1/user' &&
    jq -e --arg username "$new_username" '.login == $username and .is_admin == true' \
      "$response" >/dev/null; then
    return 0
  fi
  rm -f "$response"
  return 1
}

if ! probe_new_login; then
  write_auth_config "$current_username" "$current_password"
  if [ "$current_username" != "$new_username" ] &&
    ! in_service_netns curl --config "$curl_config" \
      --output "$response" \
      "http://127.0.0.1:3000/api/v1/users/$new_username"; then
    jq -n \
      --arg username "$new_username" \
      --arg password "$new_password" \
      --arg email "$new_username@example.invalid" \
      '{username:$username,password:$password,email:$email,must_change_password:false}' \
      > "$request"
    if ! in_service_netns curl --config "$curl_config" \
      --request POST \
      --data-binary "@$request" \
      --output "$response" \
      'http://127.0.0.1:3000/api/v1/admin/users'; then
      printf '%s\n' 'Forgejo API user creation failed' >&2
      exit 70
    fi
  fi

  jq -n --arg password "$new_password" \
    '{password:$password,admin:true,must_change_password:false,prohibit_login:false}' \
    > "$request"
  if ! in_service_netns curl --config "$curl_config" \
    --request PATCH \
    --data-binary "@$request" \
    --output "$response" \
    "http://127.0.0.1:3000/api/v1/admin/users/$new_username"; then
    printf '%s\n' 'Forgejo API administrator promotion failed' >&2
    exit 71
  fi
  if ! probe_new_login; then
    printf '%s\n' 'Forgejo promoted administrator verification failed' >&2
    exit 72
  fi
fi

if [ "$current_username" != "$new_username" ]; then
  write_auth_config "$new_username" "$new_password"
  jq -n '{prohibit_login:true}' > "$request"
  if ! in_service_netns curl --config "$curl_config" \
    --request PATCH \
    --data-binary "@$request" \
    --output "$response" \
    "http://127.0.0.1:3000/api/v1/admin/users/$current_username"; then
    printf '%s\n' 'Forgejo previous administrator disable failed' >&2
    exit 73
  fi
fi

if ! probe_new_login; then
  printf '%s\n' 'Forgejo final administrator verification failed' >&2
  exit 74
fi
rm -f "$curl_config" "$request" "$response"
printf '%s\n' 'FORGEJO_CONFIGURATION=ready'
