#!/bin/sh
set -eu
umask 077

secret='/run/gnx/opentofu-password'
configuration='/run/gnx/opentofu.env'
diagnostic='/run/gnx/opentofu-journal'

cleanup() {
  podman rm -f gnx-opentofu >/dev/null 2>&1 || true
  rm -f "$secret" "$configuration" "$diagnostic"
}
trap cleanup EXIT HUP INT TERM

IFS= read -r pve_password
IFS= read -r node_name
IFS= read -r install_garage
IFS= read -r install_forgejo

[ "${#pve_password}" -ge 12 ] || exit 64
case "$node_name" in
  ''|*[!a-z0-9-]*|-*|*-) exit 65 ;;
esac
case "$node_name" in
  gnx-controller-*) ;;
  *) exit 65 ;;
esac
[ "${#node_name}" -le 63 ] || exit 65
case "$install_garage:$install_forgejo" in
  0:0|0:1|1:0|1:1) ;;
  *) exit 66 ;;
esac

install -d -m 0700 /run/gnx /var/lib/quetzalcoatl/opentofu/controller
printf '%s' "$pve_password" > "$secret"
chmod 0400 "$secret"
unset pve_password
printf 'GNX_NODE_NAME=%s\nGNX_INSTALL_GARAGE=%s\nGNX_INSTALL_FORGEJO=%s\n' \
  "$node_name" "$install_garage" "$install_forgejo" > "$configuration"
chmod 0600 "$configuration"

systemctl daemon-reload
systemctl stop gnx-opentofu.service >/dev/null 2>&1 || true
systemctl reset-failed gnx-opentofu.service opentofu-image.service >/dev/null 2>&1 || true
if ! systemctl start gnx-opentofu.service >/dev/null 2>&1; then
  journalctl --no-pager -o cat -n 120 -u gnx-opentofu.service > "$diagnostic" 2>/dev/null || true
  stage=$(grep '^GNX_OPENTOFU_STAGE=' "$diagnostic" | tail -n 1 || true)
  if [ -n "$stage" ]; then
    printf '%s\n' "$stage" >&2
  fi
  sed '/ container \(died\|remove\) /d' "$diagnostic" | tail -n 32 >&2 || true
  exit 67
fi
systemctl is-active --quiet gnx-opentofu.service
printf 'OPENTOFU=ready\n'
