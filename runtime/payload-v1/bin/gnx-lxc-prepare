#!/bin/sh
set -eu
umask 077

IFS= read -r service
case "$service" in
  garage) vmid=200 ;;
  forgejo) vmid=201 ;;
  *) exit 64 ;;
esac

config="/etc/pve/lxc/$vmid.conf"
bootstrap='/usr/libexec/quetzalcoatl/gnx-lxc-docker-bootstrap'
guest_bootstrap='/root/gnx-lxc-docker-bootstrap'
test -s "$config"
test -x "$bootstrap"
install -d -m 0700 /run/gnx
pct config "$vmid" | grep -Eq "^hostname: gnx-$service$"
pct config "$vmid" | grep -Eq '^features: .*nesting=1'

# bpg/proxmox 0.111.1 does not delete retained devN entries when the
# device_passthrough list shrinks. Converge only the obsolete FUSE duplicate;
# features.fuse remains the single authority for /dev/fuse.
stale_fuse_devices=$(
  pct config "$vmid" |
    awk -F ': ' '/^dev[0-9]+:/ && $0 ~ /path=\/dev\/fuse(,|$)/ { print $1 }'
)
if [ -n "$stale_fuse_devices" ]; then
  if pct status "$vmid" | grep -q 'status: running'; then
    pct stop "$vmid" >/dev/null
  fi
  for device in $stale_fuse_devices; do
    case "$device" in
      dev[0-9]*) ;;
      *) exit 66 ;;
    esac
    pct set "$vmid" --delete "$device" >/dev/null
  done
fi

required_lines='lxc.apparmor.profile: unconfined
lxc.cgroup2.devices.allow: a
lxc.cap.drop:
lxc.mount.auto: proc:rw sys:rw'
needs_update=0
while IFS= read -r line; do
  grep -Fqx "$line" "$config" || needs_update=1
done <<EOF
$required_lines
EOF

if [ "$needs_update" -eq 1 ]; then
  if pct status "$vmid" | grep -q 'status: running'; then
    pct stop "$vmid" >/dev/null
  fi
  while IFS= read -r line; do
    grep -Fqx "$line" "$config" || printf '%s\n' "$line" >> "$config"
  done <<EOF
$required_lines
EOF
fi

if pct status "$vmid" | grep -q 'status: stopped'; then
  start_log="/run/gnx/lxc-$vmid-start.log"
  failure_log="$start_log.failures"
  rm -f "$start_log"
  rm -f "$failure_log"
  if ! pct start "$vmid" --debug > "$start_log" 2>&1; then
    pct config "$vmid" | grep -E '^(dev[0-9]+|features|lxc\.)[: ]' >&2 || true
    grep -Ei 'produced output|could not|file exists|permission denied|failed to|error' \
      "$start_log" > "$failure_log" || true
    if [ -s "$failure_log" ]; then
      tail -n 40 "$failure_log" >&2
    else
      tail -n 40 "$start_log" >&2 || true
    fi
    rm -f "$start_log" "$failure_log"
    exit 70
  fi
  rm -f "$start_log" "$failure_log"
fi

attempt=0
ready=0
while [ "$attempt" -lt 90 ]; do
  attempt=$((attempt + 1))
  if pct exec "$vmid" -- systemctl is-system-running >/dev/null 2>&1; then
    ready=1
    break
  fi
  state=$(pct exec "$vmid" -- systemctl is-system-running 2>/dev/null || true)
  if [ "$state" = 'degraded' ]; then
    ready=1
    break
  fi
  sleep 2
done
[ "$ready" -eq 1 ] || exit 65

cleanup() {
  pct exec "$vmid" -- rm -f "$guest_bootstrap" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM
pct push "$vmid" "$bootstrap" "$guest_bootstrap" --perms 0755 >/dev/null
output=$(pct exec "$vmid" -- "$guest_bootstrap")
[ "$(printf '%s\n' "$output" | tail -n 1)" = 'LXC_DOCKER=ready' ]
cleanup
trap - EXIT HUP INT TERM
printf 'LXC_DOCKER=ready;SERVICE=%s;VMID=%s\n' "$service" "$vmid"
