#!/bin/sh
set -eu
umask 077

image='ghcr.io/opentofu/opentofu@sha256:6b66d996afc7f043154e33a0420285d0d58c165305ac8f36d32df213a3c4bbd4'
source_workspace='/usr/share/quetzalcoatl/opentofu/controller'
workspace='/var/lib/quetzalcoatl/opentofu/controller'
secret='/run/gnx/opentofu-password'
configuration='/run/gnx/opentofu.env'
entrypoint='/usr/libexec/quetzalcoatl/gnx-opentofu-entrypoint'

test "$(stat -c '%u:%a' "$secret")" = '0:400'
test "$(stat -c '%u:%a' "$configuration")" = '0:600'
test -x "$entrypoint"

node_name=$(sed -n 's/^GNX_NODE_NAME=//p' "$configuration")
install_garage=$(sed -n 's/^GNX_INSTALL_GARAGE=//p' "$configuration")
install_forgejo=$(sed -n 's/^GNX_INSTALL_FORGEJO=//p' "$configuration")
[ "$(grep -c '^GNX_NODE_NAME=' "$configuration")" -eq 1 ]
[ "$(grep -c '^GNX_INSTALL_GARAGE=' "$configuration")" -eq 1 ]
[ "$(grep -c '^GNX_INSTALL_FORGEJO=' "$configuration")" -eq 1 ]
case "$node_name" in
  ''|*[!a-z0-9-]*|-*|*-) exit 64 ;;
esac
case "$node_name" in
  gnx-controller-*) ;;
  *) exit 64 ;;
esac
case "$install_garage:$install_forgejo" in
  0:0|0:1|1:0|1:1) ;;
  *) exit 65 ;;
esac

install -d -m 0700 "$workspace"
install -m 0600 "$source_workspace/main.tf" "$workspace/main.tf"
install -m 0600 "$source_workspace/versions.tf" "$workspace/versions.tf"
install -m 0600 "$source_workspace/.terraform.lock.hcl" "$workspace/.terraform.lock.hcl"

podman exec gnx-proxmox pvesm set local \
  --content backup,images,iso,rootdir,snippets,vztmpl >/dev/null
podman exec gnx-proxmox pvesm status --storage local >/dev/null

cleanup() {
  podman rm -f gnx-opentofu >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM
cleanup

podman run --rm \
  --name gnx-opentofu \
  --pod gnx-node \
  --security-opt label=disable \
  --volume "$workspace:/workspace" \
  --volume "$secret:/run/secrets/pve-password:ro" \
  --volume "$configuration:/run/config/opentofu.env:ro" \
  --volume "$entrypoint:/usr/local/bin/gnx-opentofu-entrypoint:ro" \
  --workdir /workspace \
  --entrypoint /usr/local/bin/gnx-opentofu-entrypoint \
  "$image"

test -s "$workspace/terraform.tfstate"
chmod 0600 "$workspace/terraform.tfstate"
if [ -e "$workspace/terraform.tfstate.backup" ]; then
  chmod 0600 "$workspace/terraform.tfstate.backup"
fi
test "$(stat -c '%u:%a' "$workspace/terraform.tfstate")" = '0:600'
printf 'OPENTOFU_RUNNER=ready\n'
