[Unit]
Description=Quetzalcoatl Proxmox VE node
Requires=gnx-node-pod.service
After=gnx-node-pod.service
Before=gnx-tailscale-enroll.service tailscaled.service

[Container]
ContainerName=gnx-proxmox
Image=ghcr.io/mayas-alas/tailnet-proxmox@sha256:9b3f516d7b645148c35396b5655ed9f9249e4d4e1c33366164a469e957e4ae53
Pod=gnx-node.pod
StartWithPod=true
PodmanArgs=--privileged
Entrypoint=/usr/local/sbin/gnx-proxmox-entrypoint
Exec=/sbin/init --log-target=console --log-level=notice
AddDevice=/dev/kvm
AddDevice=/dev/net/tun
AddDevice=/dev/fuse
Environment=REQUIRE_KVM=Y
Environment=REQUIRE_FUSE=Y
Environment=DEVS=eth0
Environment=BRIDGES=vmbr0
Environment=GATEWAYS=172.30.10.1
Environment=TZ=UTC
SecurityLabelDisable=true
ShmSize=1g
Volume=/var/lib/quetzalcoatl/proxmox/vz:/var/lib/vz
Volume=/var/lib/quetzalcoatl/proxmox/cluster:/var/lib/pve-cluster
Volume=/usr/libexec/quetzalcoatl/gnx-proxmox-entrypoint:/usr/local/sbin/gnx-proxmox-entrypoint:ro
Volume=/usr/libexec/quetzalcoatl/gnx-pve-cluster-create:/usr/libexec/quetzalcoatl/gnx-pve-cluster-create:ro
Volume=/usr/libexec/quetzalcoatl/gnx-lxc-docker-bootstrap:/usr/libexec/quetzalcoatl/gnx-lxc-docker-bootstrap:ro
Volume=/usr/libexec/quetzalcoatl/gnx-lxc-prepare:/usr/libexec/quetzalcoatl/gnx-lxc-prepare:ro
Volume=/usr/libexec/quetzalcoatl/gnx-lxc-service-bootstrap:/usr/libexec/quetzalcoatl/gnx-lxc-service-bootstrap:ro
Volume=/usr/libexec/quetzalcoatl/gnx-lxc-service-prepare:/usr/libexec/quetzalcoatl/gnx-lxc-service-prepare:ro
Volume=/usr/libexec/quetzalcoatl/gnx-tailscale-enroll:/usr/libexec/quetzalcoatl/gnx-tailscale-enroll:ro
Volume=/etc/quetzalcoatl/node:/etc/quetzalcoatl/node:ro
Volume=/usr/share/quetzalcoatl:/usr/share/quetzalcoatl:ro

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=1800
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
