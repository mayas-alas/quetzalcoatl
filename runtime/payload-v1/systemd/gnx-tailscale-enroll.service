[Unit]
Description=Enroll the Quetzalcoatl host in Tailscale exactly once
Requires=proxmox.service
After=proxmox.service
Before=tailscaled.service

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=-/run/gnx/tailscale-enroll.env
ExecStart=/usr/libexec/quetzalcoatl/gnx-tailscale-enroll podman host ${GNX_TS_HOSTNAME}
RemainAfterExit=yes
