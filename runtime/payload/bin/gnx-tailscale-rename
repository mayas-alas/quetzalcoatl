#!/bin/sh
set -eu
umask 077

IFS= read -r hostname
case "$hostname" in
  ''|*[!a-z0-9-]*|-*|*-) exit 64 ;;
esac
[ "${#hostname}" -le 63 ] || exit 64

node_dir='/etc/quetzalcoatl/node'
temporary="$node_dir/.node.env.tmp"
install -d -m 0755 "$node_dir"
rm -f "$temporary"
trap 'rm -f "$temporary"' EXIT HUP INT TERM
printf 'TS_HOSTNAME=%s\n' "$hostname" > "$temporary"
chmod 0600 "$temporary"
mv "$temporary" "$node_dir/node.env"

podman exec gnx-tailscaled tailscale set --hostname="$hostname" >/dev/null
systemctl restart tailscaled.service
systemctl is-active --quiet tailscaled.service
printf 'TAILSCALE_HOSTNAME=updated\n'
