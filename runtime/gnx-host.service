[Unit]
Description=Quetzalcoatl Next host runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gnx-runtime
Group=gnx-runtime
SupplementaryGroups=kvm
Environment=HOME=/var/lib/quetzalcoatl-next/runtime
Environment=XDG_CONFIG_HOME=/var/lib/quetzalcoatl-next/runtime/.config
Environment=XDG_DATA_HOME=/var/lib/quetzalcoatl-next/runtime/.local/share
Environment=XDG_RUNTIME_DIR=/run/quetzalcoatl-next
RuntimeDirectory=quetzalcoatl-next
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/quetzalcoatl-next/runtime
ExecStart=/usr/local/bin/gnx __service
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
