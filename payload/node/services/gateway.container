# Capacidad: gateway
# Implementación aprobada para este release: Caddy
# Entrada: routes.conf; compute usa HTTPS con CA explícita, nunca TLS inseguro
[Unit]
Description=GnX HTTPS gateway capability
After=mesh.service dns.service
Requires=mesh.service dns.service
[Container]
Image=docker.io/library/caddy@sha256:14a9c00d4e833ebc2b65d36515b37bde3b73f0b323a2663aaafc88953d8c4e3f
ContainerName=gnx-gateway
Network=host
# Native LXC certificates use their mesh DNS name, not the public .gnx alias.
EnvironmentFile=/var/lib/gnx-node/secrets/gateway-backends.env
Volume=/var/lib/gnx-node/routes.conf:/etc/caddy/Caddyfile:ro,Z
Volume=/var/lib/gnx-node/web-app:/srv/gnx-web:ro,Z
Volume=/var/lib/gnx-node/auth-public:/srv/gnx-auth-public:ro,Z
Volume=/var/lib/gnx-node/ca:/etc/gnx/ca:ro,Z
Volume=/var/lib/gnx-node/ai-auth:/etc/gnx/ai-auth:ro,Z
[Service]
# Podman's env-file has no systemd '-' optional syntax. Create an empty default
# without truncating an enrolled backend name; missing AI remains fail-closed.
UMask=0077
ExecStartPre=/usr/bin/touch /var/lib/gnx-node/secrets/gateway-backends.env
ExecStartPre=/usr/bin/install -d -m 0750 -o 0 -g 10001 /var/lib/gnx-node/ai-auth
Restart=always
RestartSec=5s
[Install]
WantedBy=platform.target
