#!/usr/bin/env bash
# Fixed internal authentication backend, never a host control API.
set -Eeuo pipefail
umask 077
die() { printf '{"event":"error","code":"%s"}\n' "$1" >&2; exit 1; }
[[ $(id -u) == 0 && $# == 0 ]] || die APP_AUTH_ARGUMENT
payload=/opt/gnx/payload/node
runtime=/var/lib/gnx-node
python3 "$payload/auth/configure.run" || die APP_AUTH_CONFIG_FAILED
# Only a verified, shipped archive can supply the auth images.
if ! python3 - "$payload/auth" 2>/dev/null <<'PY'
from pathlib import Path
import hashlib, tarfile, sys
p=Path(sys.argv[1]); expected=(p/'offline.sha256').read_text().split()
assert len(expected)==2 and expected[1]=='offline.tar.gz'
h=hashlib.sha256()
with (p/'offline.tar.gz').open('rb') as f:
    for b in iter(lambda:f.read(4*1024*1024),b''):h.update(b)
assert h.hexdigest()==expected[0]
with tarfile.open(p/'offline.tar.gz','r:gz') as archive:
    entries=archive.getmembers()
    assert {m.name for m in entries}=={'oauth2-proxy.tar','valkey.tar'}
    assert all(m.isfile() for m in entries)
    archive.extractall('/var/lib/gnx-node/app-auth/images',members=entries,filter='data')
PY
then die APP_AUTH_OFFLINE_BUNDLE_INVALID; fi
for pair in 'app-auth oauth2-proxy' 'app-sessions valkey'; do
  read -r unit image <<< "$pair"
  ref=$(awk -F= '$1=="Image" {print $2}' "$payload/services/$unit.container")
  if ! podman image exists "$ref"; then
    podman load -i "$runtime/app-auth/images/$image.tar" >/dev/null 2>&1 || die APP_AUTH_OFFLINE_IMAGE_REQUIRED
  fi
  podman image exists "$ref" || die APP_AUTH_OFFLINE_PIN_MISMATCH
  install -m 0644 "$payload/services/$unit.container" "/etc/containers/systemd/$unit.container"
done
rm -rf "$runtime/app-auth/images"
# Discover only an owned, running guest. Never wake a stopped guest for auth.
vmid=''
while read -r id; do
  [[ "$id" =~ ^[1-9][0-9]{2,8}$ ]] || continue
  if podman exec gnx-compute /usr/sbin/pct config "$id" 2>/dev/null | grep -Eq '^tags: .*\bgnx-rustfs\b'; then
    [[ -z "$vmid" ]] || die APP_AUTH_DUPLICATE_GUEST
    vmid=$id
  fi
done < <(podman exec gnx-compute /usr/sbin/pct list 2>/dev/null | awk 'NR>1 {print $1}')
[[ -n "$vmid" ]] || die APP_AUTH_POCKET_REQUIRED
podman exec gnx-compute /usr/sbin/pct status "$vmid" | grep -q running || die APP_AUTH_POCKET_REQUIRED
# Product-owned protected staging, removed in finally. Never put credentials in
# stdout, argv, environment, source payload, or a browser credential bridge.
stage=/var/lib/gnx-app-auth-transfer
cleanup() { podman exec gnx-compute /usr/bin/rm -rf "$stage" >/dev/null 2>&1 || true; }
trap cleanup EXIT
podman exec gnx-compute /usr/bin/install -d -m 0700 "$stage"
podman cp "$runtime/app-auth/pocket-client.json" "gnx-compute:$stage/client.json"
podman cp "$payload/workloads/private-services/app-enroll.run" "gnx-compute:$stage/enroll.run"
podman exec gnx-compute /usr/sbin/pct push "$vmid" "$stage/client.json" /var/lib/gnx/access/pwa-client.json --perms 0600 >/dev/null
podman exec gnx-compute /usr/sbin/pct push "$vmid" "$stage/enroll.run" /usr/local/libexec/gnx-app-enroll --perms 0755 >/dev/null
podman exec gnx-compute /usr/sbin/pct exec "$vmid" -- /usr/local/libexec/gnx-app-enroll || die APP_AUTH_ENROLL_FAILED
systemctl daemon-reload
systemctl restart app-sessions.service >/dev/null 2>&1 || die APP_AUTH_SESSIONS_FAILED
systemctl restart app-auth.service >/dev/null 2>&1 || die APP_AUTH_START_FAILED
printf '%s\n' '{"event":"app_auth_ready","group":"gnx-app-users"}'
