#!/usr/bin/env python3
"""Persistent product secrets; never values in argv/environment/output."""
import json
import os
import secrets
import stat
import sys
from pathlib import Path

BASE = Path('/var/lib/gnx-node/app-auth')
PAYLOAD = Path('/opt/gnx/payload/node/auth')


def private(path):
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) not in (0o600, 0o640):
        raise ValueError('permissions')
    return path.read_bytes()


def put(path, data, shared=True):
    if path.exists() and private(path) == data:
        return
    staging = path.with_suffix(path.suffix + '.new')
    fd = os.open(staging, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chown(staging, 0, 10001 if shared else 0)
    os.chmod(staging, 0o640 if shared else 0o600)
    staging.replace(path)


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise ValueError('arguments')
    os.umask(0o077)
    BASE.mkdir(mode=0o750, exist_ok=True)
    st = BASE.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
        raise ValueError('directory')
    os.chown(BASE, 0, 10001)
    os.chmod(BASE, 0o750)
    owner = BASE / 'owner.json'
    if not owner.exists():
        put(owner, json.dumps({'client_id': 'gnx-app-' + secrets.token_hex(8),
                               'client_secret': secrets.token_urlsafe(32),
                               'redis_password': secrets.token_hex(32)}).encode(), False)
    state = json.loads(private(owner))
    if not all(isinstance(state.get(k), str) and state[k] for k in ('client_id', 'client_secret', 'redis_password')):
        raise ValueError('state')
    cookie = BASE / 'cookie.secret'
    if not cookie.exists():
        put(cookie, secrets.token_bytes(32))
    if len(private(cookie)) != 32:
        raise ValueError('cookie')
    put(BASE / 'client.secret', state['client_secret'].encode())
    config = (PAYLOAD / 'oauth2-proxy.cfg').read_text()
    config += '\nclient_id = ' + json.dumps(state['client_id']) + '\nredis_password = ' + json.dumps(state['redis_password']) + '\n'
    put(BASE / 'oauth2-proxy.cfg', config.encode())
    redis = ('bind 127.0.0.1\nport 6380\nprotected-mode yes\nsave ""\nappendonly no\n'
             'maxmemory 64mb\nmaxmemory-policy noeviction\nloglevel warning\n'
             'requirepass ' + state['redis_password'] + '\n')
    put(BASE / 'sessions.conf', redis.encode())
    # Only the client credential crosses into the owned guest over protected files.
    put(BASE / 'pocket-client.json', json.dumps({k: state[k] for k in ('client_id', 'client_secret')}).encode(), False)
    print('{"event":"app_auth_configured"}')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError):
        print('{"event":"error","code":"APP_AUTH_CONFIG_FAILED"}', file=sys.stderr)
        raise SystemExit(1)
