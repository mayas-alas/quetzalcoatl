# Non-secret adapter configuration. Copy this file outside the repository and edit it.
# The GitHub token is supplied separately with --token-file or --token-stdin.
GNX_GITHUB_API=https://api.github.com
GNX_GITHUB_REPOSITORY=OWNER/PRIVATE-REPOSITORY
GNX_GITHUB_WORKFLOW=gnx-ephemeral-exit-node.yml
GNX_GITHUB_REF=main
GNX_LEASE_MINUTES=60
GNX_POLL_SECONDS=10
# Optional protected file; --token-file always takes precedence.
# GNX_GITHUB_TOKEN_FILE=/run/gnx-node/actions/github-token
