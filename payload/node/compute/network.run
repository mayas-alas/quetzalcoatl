#!/usr/bin/env bash
# Permanent compute boot contract: repair only GnX-owned transport and guests.
set -Eeuo pipefail
fail() { printf 'GnX LXC network: %s\n' "$1" >&2; exit 1; }
[[ $(id -u) == 0 ]] || fail ROOT_REQUIRED
# Native netdev ingress gate covers DHCP, IPv4/IPv6 and existing flows.
# Close before starting/reconciling a managed guest; open only after its guard
# has loaded. Do not rely on the guest having booted systemd/networkd already.
transport() {
  local action=$1 vmid=$2
  [[ "$vmid" =~ ^[1-9][0-9]{2,8}$ ]] || fail VMID_INVALID
  if ! command -v nft >/dev/null 2>&1; then
    # An old image without the native gate must not keep an unguarded guest up.
    pct stop "$vmid" >/dev/null 2>&1 || true
    fail TRANSPORT_GATE_UNAVAILABLE
  fi
  if ! nft list table netdev gnx_lxc_transport >/dev/null 2>&1; then
    if ! nft -f - <<'NFT'
table netdev gnx_lxc_transport {
  set blocked { type ifname; }
}
NFT
    then
      pct stop "$vmid" >/dev/null 2>&1 || true
      fail TRANSPORT_GATE_UNAVAILABLE
    fi
  fi
  # Bind the exact future interface name: a wildcard hook can be accepted by
  # nft while never seeing dynamically created veth devices on this kernel.
  if ! nft list chain netdev gnx_lxc_transport "guest_$vmid" >/dev/null 2>&1; then
    if ! nft -f - <<NFT
add chain netdev gnx_lxc_transport guest_$vmid { type filter hook ingress device "veth${vmid}i0" priority -500; policy accept; }
add rule netdev gnx_lxc_transport guest_$vmid iifname @blocked counter drop
NFT
    then
      pct stop "$vmid" >/dev/null 2>&1 || true
      fail TRANSPORT_GATE_UNAVAILABLE
    fi
  fi
  if [[ "$action" == close ]]; then
    nft "add element netdev gnx_lxc_transport blocked { \"veth${vmid}i0\" }" || {
      pct stop "$vmid" >/dev/null 2>&1 || true
      fail TRANSPORT_GATE_UNAVAILABLE
    }
  else
    # Reload the reviewed policy, rather than trusting a stale unit status.
    pct exec "$vmid" -- /usr/local/libexec/gnx-workload-mesh guard || fail MESH_GUARD_REQUIRED
    nft "delete element netdev gnx_lxc_transport blocked { \"veth${vmid}i0\" }"
  fi
}
if [[ $# != 0 ]]; then
  [[ $# == 2 && ( "$1" == close || "$1" == open ) ]] || fail INVALID_ARGUMENT
  transport "$1" "$2"
  exit 0
fi
# Dockurr creates this bridge before starting systemd; derive its actual pool.
address=$(ip -4 -o address show dev vmbr0 scope global | awk '$4 !~ /\/32$/ {print $4; exit}')
[[ "$address" =~ ^172\.[0-9]+\.[0-9]+\.1/24$ ]] || fail BRIDGE_ADDRESS_INVALID
subnet="${address%.1/24}.0/24"
# Close every managed interface before changing any host transport rules.
while read -r vmid; do
  [[ "$vmid" =~ ^[1-9][0-9]{2,8}$ ]] || continue
  config=$(pct config "$vmid")
  grep -Eq '^tags: .*\bgnx-rustfs\b' <<< "$config" || continue
  pct set "$vmid" --nameserver 100.100.100.100 >/dev/null
  transport close "$vmid"
done < <(pct list | awk 'NR > 1 {print $1}')
sysctl -w net.ipv4.ip_forward=1 >/dev/null
# Do not flush PVE rules or disable its firewall. Permit only DHCP to this
# private bridge, then route/NAT its transport. The guest guard owns egress.
rule() { local table=$1 chain=$2; shift 2; iptables -w -t "$table" -C "$chain" "$@" 2>/dev/null || iptables -w -t "$table" -I "$chain" 1 "$@"; }
rule filter INPUT -i vmbr0 -p udp --sport 68 --dport 67 -m comment --comment GNX_LXC_DHCP -j ACCEPT
rule filter FORWARD -i vmbr0 -o eth0 -s "$subnet" -m comment --comment GNX_LXC_TRANSPORT -j ACCEPT
rule filter FORWARD -i eth0 -o vmbr0 -d "$subnet" -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment GNX_LXC_RETURN -j ACCEPT
rule nat POSTROUTING -s "$subnet" -o eth0 -m comment --comment GNX_LXC_NAT -j MASQUERADE
# Existing managed guests need the same networkd config as newly created ones.
while read -r vmid; do
  [[ "$vmid" =~ ^[1-9][0-9]{2,8}$ ]] || continue
  config=$(pct config "$vmid")
  grep -Eq '^tags: .*\bgnx-rustfs\b' <<< "$config" || continue
  transport close "$vmid"
  if ! pct status "$vmid" | grep -q running; then
    # Reconcile only autostart guests; deliberately stopped workloads stay off.
    grep -qx 'onboot: 1' <<< "$config" || continue
    pct start "$vmid"
  fi
  pct exec "$vmid" -- mkdir -p /etc/systemd/network /usr/local/libexec
  pct push "$vmid" /etc/gnx/network/eth0.network /etc/systemd/network/10-gnx-eth0.network --perms 0644
  pct push "$vmid" /etc/gnx/network/guest-network.run /usr/local/libexec/gnx-configure-network --perms 0755
  # Missing offline dependencies leave the host ingress gate closed.
  if ! pct exec "$vmid" -- /usr/local/libexec/gnx-workload-mesh guard; then
    printf 'GnX guest %s blocked: MESH_GUARD_REQUIRED\n' "$vmid" >&2
    continue
  fi
  transport open "$vmid"
  if ! pct exec "$vmid" -- /usr/local/libexec/gnx-configure-network; then
    transport close "$vmid"
    fail GUEST_NETWORK_FAILED
  fi
done < <(pct list | awk 'NR > 1 {print $1}')
printf '%s\n' 'GnX LXC transport configured'
