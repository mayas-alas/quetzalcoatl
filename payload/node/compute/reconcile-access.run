#!/usr/bin/env bash
# Called after gateway activation in the explicit credential-preserving upgrade.
set -Eeuo pipefail
[[ $(id -u) == 0 && $# == 0 ]] || exit 64
payload=/opt/gnx/payload/node
runtime=/var/lib/gnx-node
install -m 0755 "$payload/compute/netbird-stun.run" "$runtime/netbird-stun.run"
install -m 0755 "$payload/compute/access-verify.run" "$runtime/access-verify.run"
install -m 0755 "$payload/compute/access-mesh-policy.run" "$runtime/access-mesh-policy.run"
install -m 0644 "$payload/services/netbird-stun.service" /etc/systemd/system/netbird-stun.service
systemctl daemon-reload
systemctl enable netbird-stun.service >/dev/null
status=$(bash "$runtime/lxc.run" status rustfs)
# Never create a new guest or wake a stopped one during an update.
if python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin).get("state") == "running" else 1)' <<< "$status"; then
  systemctl restart netbird-stun.service
  python3 "$runtime/access-mesh-policy.run"
  bash "$runtime/lxc.run" start rustfs
fi
