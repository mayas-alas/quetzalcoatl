#!/usr/bin/env bash
# Read-only access diagnostics. Print statuses, never env/config/credentials.
set -uo pipefail
[[ $(id -u) == 0 && $# == 0 ]] || exit 64
if [[ -f /opt/gnx/payload/node/auth/verify.run ]]; then
  /usr/bin/python3 /opt/gnx/payload/node/auth/verify.run
  /usr/bin/timeout 20 /bin/bash /opt/gnx/payload/node/verify.run --state-dir /mnt/c/ProgramData/GnX/Node/state
fi
record=/var/lib/gnx-node/dnsmasq.d/03-rustfs.conf
peer=$(awk -F/ '$2 == "pocket.mesh.gnx" {print $3}' "$record")
node=$(/usr/bin/podman exec gnx-mesh tailscale ip -4)
[[ "$peer" =~ ^100\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || exit 1
policy="${BASH_SOURCE[0]%/*}/access-mesh-policy.run"
if [[ -f "$policy" ]]; then
  /usr/bin/python3 "$policy"
fi
code=$(/usr/bin/curl --silent --connect-timeout 3 --max-time 5 -o /dev/null -w '%{http_code}' --cacert /var/lib/gnx-node/ca/gateway-ca.pem --resolve "rustfs.gnx:443:$peer" https://rustfs.gnx/rustfs/console/)
printf 'backend_tcp_443: curl=%s http=%s\n' "$?" "$code"
/usr/bin/podman exec gnx-compute /usr/sbin/pct exec 100 -- /usr/sbin/nft list table inet gnx_workload_mesh
/usr/bin/podman exec gnx-compute /usr/sbin/pct exec 100 -- /usr/bin/podman exec gnx-workload-mesh tailscale --socket=/var/lib/tailscale/tailscaled.sock debug netmap 2>/dev/null | /usr/bin/python3 -c '
import json,sys,ipaddress
try:
 data=json.load(sys.stdin)
 if "PacketFilterRules" not in data:
  print("guest_acl_check_unavailable; schema_keys="+",".join(sorted(data.keys())))
  raise SystemExit(0)
 rules=data["PacketFilterRules"]
 node,peer=sys.argv[1:]
 def contains(cidr, ip):
  if cidr == "*": return True
  return ipaddress.ip_address(ip) in ipaddress.ip_network(cidr,strict=False)
 for port in [443,1411,8080,8081,3478]:
  allowed=any(any(contains(s,node) for s in r.get("SrcIPs",[])) and any(contains(d.get("IP",""),peer) and d.get("Ports",{}).get("First",0)<=port<=d.get("Ports",{}).get("Last",65535) for d in r.get("DstPorts",[])) for r in rules)
  print(json.dumps({"guest_acl_port":port,"allowed":allowed}))
except (ValueError,TypeError,KeyError): print("guest_acl_check_unavailable")
' "$node" "$peer"
for port in 1411 8080 8081; do
  code=$(/usr/bin/curl --silent --connect-timeout 3 --max-time 5 -o /dev/null -w '%{http_code}' "http://$peer:$port/")
  printf 'backend_tcp_%s: curl=%s http=%s\n' "$port" "$?" "$code"
done
/usr/bin/podman logs --since 5m gnx-gateway 2>&1 | /usr/bin/python3 -c '
import sys,json
for line in sys.stdin:
 try: entry=json.loads(line)
 except ValueError: continue
 if entry.get("level") != "error": continue
 error=str(entry.get("err",entry.get("error",entry.get("msg","")))).lower()
 category="other"
 for needle,label in [("no such host","dns"),("timeout","timeout"),("refused","refused"),("certificate","tls")]:
  if needle in error: category=label; break
 print(json.dumps({"gateway_error":category,"status":entry.get("status")}))
'
/usr/bin/systemctl is-active netbird-stun.service
for unit in app-auth app-sessions; do
  /usr/bin/systemctl show "$unit.service" -p ActiveState -p SubState -p Result -p ExecMainStatus -p LoadState -p FragmentPath
  /usr/bin/journalctl -u "$unit.service" --no-pager -n 20 | /usr/bin/python3 -c '
import sys,json
for line in sys.stdin:
 text=line.lower()
 if any(n in text for n in ["cycle", "dependency", "deadlock", "failed", "not found", "unknown", "permission", "error"]):
  if any(n in text for n in ["secret", "password", "cookie", "token", "authorization"]):
   print("app_auth_journal_sensitive_error_redacted")
  else: print(line.rstrip()[:500])
'
  /usr/bin/podman logs --tail 30 "gnx-$unit" 2>&1 | /usr/bin/python3 -c '
import sys,json,re
text=sys.stdin.read().lower()
needles=["invalid configuration", "unknown", "cookie", "redis", "permission denied", "connection refused", "oidc", "nonce", "email", "flag", "unmarshal", "config", "upstream", "certificate", "not found"]
print(json.dumps({"app_auth_log_categories":[n for n in needles if n in text]}))
for m in re.finditer(r"(?:unknown (?:field|flag|key)|invalid (?:field|option)|unused keys|invalid keys)[^\\n]{0,160}",text):
 safe=re.sub(r"[^a-z0-9_ ,:=\\[\\]-]","",m.group())
 print(json.dumps({"app_auth_config_field":safe}))
'
done
