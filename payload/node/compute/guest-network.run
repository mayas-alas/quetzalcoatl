#!/usr/bin/env bash
# Installed permanently in each GnX guest, never downloaded at runtime.
set -Eeuo pipefail
[[ $(id -u) == 0 && $# == 0 ]] || exit 1
# No DHCP client or direct route may be enabled without the reviewed guard.
/usr/local/libexec/gnx-workload-mesh guard || { printf '%s\n' MESH_GUARD_REQUIRED >&2; exit 1; }
# One owner per interface. PVE's Debian setup writes ifupdown configuration;
# our sealed guest contract uses networkd, so do not run two DHCP clients.
if [[ $(systemctl show networking.service -p LoadState --value) == loaded ]]; then
  systemctl disable --now networking.service >/dev/null
fi
systemctl enable systemd-networkd.service >/dev/null
systemctl restart systemd-networkd.service
for _ in $(seq 1 30); do
  if ip -4 -o address show dev eth0 scope global | grep -q 'inet ' &&
     ip -4 route show default | grep -q 'via .* dev eth0'; then
    printf '%s\n' 'GnX guest DHCP and default route ready'
    exit 0
  fi
  sleep 1
done
printf '%s\n' 'GUEST_DHCP_TIMEOUT' >&2
exit 1
