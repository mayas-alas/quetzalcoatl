#!/usr/bin/env python3
"""Sanitized private-gateway checks: HTTPS, OIDC, gRPC, relay WS and STUN."""
import base64
import http.client
import json
import os
import socket
import ssl
import struct
import subprocess
import sys

CA = '/var/lib/gnx-node/ca/gateway-ca.pem'
context = ssl.create_default_context(cafile=CA)
failed = False


def check(name, fn):
    global failed
    try:
        fn()
        result = 'pass'
    except (OSError, ValueError, AssertionError, subprocess.SubprocessError, KeyError):
        result = 'fail'
        failed = True
    print(json.dumps({'check': name, 'result': result}))


def connection(host):
    c = http.client.HTTPSConnection(host, context=context, timeout=10)
    c._create_connection = lambda *a, **kw: socket.create_connection(('127.0.0.1', 443), timeout=10)
    return c


def discovery(host, path, issuer):
    c = connection(host)
    try:
        c.request('GET', path)
        r = c.getresponse()
        assert r.status == 200
        assert json.loads(r.read())['issuer'] == issuer
    finally:
        c.close()


def dashboard():
    c = connection('netbird.gnx')
    try:
        c.request('GET', '/')
        r = c.getresponse()
        assert r.status == 200 and b'NetBird' in r.read()
    finally:
        c.close()


def grpc_response_valid(raw_headers, expected):
    lines = [line.strip().lower() for line in raw_headers.decode(errors='replace').splitlines()]
    fields = {name.strip(): value.strip() for line in lines if ':' in line
              for name, _, value in [line.partition(':')]}
    return ('http/2 200' in lines
            and fields.get('content-type', '').startswith('application/grpc')
            and fields.get('grpc-status') == expected)


def grpc(path, expected):
    r = subprocess.run(['curl', '--http2', '--fail', '--silent', '--show-error', '--max-time', '10',
                        '--cacert', CA, '--resolve', 'netbird.gnx:443:127.0.0.1',
                        '-H', 'Content-Type: application/grpc', '-H', 'TE: trailers',
                        '--data-binary', '@-', '-D', '-', '-o', '/dev/null',
                        'https://netbird.gnx' + path], input=b'\0\0\0\0\0', capture_output=True, check=True)
    assert grpc_response_valid(r.stdout, expected)


def relay():
    c = connection('netbird.gnx')
    key = base64.b64encode(os.urandom(16)).decode()
    try:
        c.request('GET', '/relay', headers={'Connection': 'Upgrade', 'Upgrade': 'websocket',
                                          'Sec-WebSocket-Key': key, 'Sec-WebSocket-Version': '13'})
        r = c.getresponse()
        assert r.status == 101 and r.getheader('Upgrade', '').lower() == 'websocket'
    finally:
        c.close()


def stun():
    node = subprocess.check_output(['podman', 'exec', 'gnx-mesh', 'tailscale', 'ip', '-4'], text=True).strip()
    assert node.startswith('100.')
    xid = os.urandom(12)
    message = struct.pack('!HHI', 1, 0, 0x2112A442) + xid
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(5)
        s.sendto(message, (node, 3478))
        reply, _ = s.recvfrom(2048)
    assert len(reply) >= 20 and reply[0:2] == b'\x01\x01' and reply[8:20] == xid


check('pocket_oidc_https', lambda: discovery('pocket.gnx', '/.well-known/openid-configuration', 'https://pocket.gnx'))
check('netbird_oidc_https', lambda: discovery('netbird.gnx', '/oauth2/.well-known/openid-configuration', 'https://netbird.gnx/oauth2'))
check('netbird_dashboard_https', dashboard)
check('netbird_management_grpc', lambda: grpc('/management.ManagementService/GetServerKey', '0'))
# The pinned Signal dispatcher acknowledges this empty/no-recipient probe with
# status 0. Require the real HTTP/2 gRPC response, never an HTML/UI fallback.
check('netbird_signal_grpc', lambda: grpc('/signalexchange.SignalExchange/Send', '0'))
check('netbird_relay_websocket', relay)
check('netbird_stun', stun)
raise SystemExit(1 if failed else 0)
