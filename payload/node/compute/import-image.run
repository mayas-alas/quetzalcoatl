#!/usr/bin/env bash
# Skopeo-only OCI acquisition; no raw HTTP archive channel, build, or apt in compute.
# Wired into install/reconcile only when a reviewed registry release is promoted.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
die() { printf '{"event":"error","code":"%s"}\n' "$1" >&2; exit 1; }
[[ $# == 1 && $(id -u) == 0 ]] || die COMPUTE_IMAGE_ARGUMENT
payload_dir=$1
for tool in python3 skopeo podman sha256sum; do command -v "$tool" >/dev/null || die COMPUTE_IMAGE_PREREQUISITE; done
configuration=$(python3 - "$payload_dir/compute/image/release.json" "$payload_dir/services/compute.container" 2>/dev/null <<'PY'
import json, re, sys
from pathlib import Path
config = json.loads(Path(sys.argv[1]).read_text())
assert config["status"] == "promoted", "Candidate is not a deployable release"
image, source, tag, digest = (config[key] for key in ("image", "source", "storage_tag", "manifest_digest"))
assert re.fullmatch(r"sha256:[0-9a-f]{64}", digest)
assert re.fullmatch(r"[a-z0-9][a-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9][a-z0-9_./-]*@sha256:[0-9a-f]{64}", image)
assert ".." not in image and "//" not in image
assert source == "docker://" + image and image.endswith("@" + digest)
assert re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", config["release"])
assert tag == image.split("@", 1)[0] + ":" + config["release"]
quadlet = Path(sys.argv[2]).read_text().splitlines()
assert [line for line in quadlet if line.startswith("Image=")] == ["Image=" + image]
assert "Pull=never" in quadlet
print(source, image, tag, digest, sep="\n")
PY
) || die COMPUTE_IMAGE_CONFIG_INVALID
mapfile -t values <<< "$configuration"
source=${values[0]}; image=${values[1]}; tag=${values[2]}; digest=${values[3]}
# This is the node's own containers-storage/auth context, never the host user's
# store/credentials. Public OCI access is preferred; private auth needs explicit
# operator provisioning outside this script. Skopeo's normal policy is retained.
if ! podman image exists "$image"; then
  manifest_digest=$(skopeo inspect --tls-verify=true --no-tags --raw "$source" | sha256sum | cut -d' ' -f1) || die COMPUTE_IMAGE_INSPECT_FAILED
  [[ "sha256:$manifest_digest" == "$digest" ]] || die COMPUTE_IMAGE_DIGEST_MISMATCH
  skopeo copy --retry-times 3 --preserve-digests --src-tls-verify=true \
    "$source" "containers-storage:$tag" >/dev/null 2>&1 || die COMPUTE_IMAGE_COPY_FAILED
fi
podman image exists "$image" || die COMPUTE_IMAGE_DIGEST_MISMATCH
printf '%s\n' '{"event":"compute_image_ready"}'
