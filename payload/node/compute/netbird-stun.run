#!/usr/bin/env bash
# Only UDP STUN is forwarded; control/UI still terminate at the private gateway.
set -Eeuo pipefail
fail() { printf '{"event":"error","code":"%s"}\n' "$1" >&2; exit 1; }
[[ $(id -u) == 0 && $# == 0 ]] || fail STUN_ARGUMENT
record=/var/lib/gnx-node/dnsmasq.d/03-rustfs.conf
# A new node has no managed LXC yet. Do not create a wildcard forward.
[[ -r "$record" ]] || exit 0
peer=$(awk -F/ '$2 == "netbird.mesh.gnx" {print $3}' "$record")
# Query the enrolled sidecar; the sealed host rootfs need not ship iproute2.
node=$(/usr/bin/podman exec gnx-mesh tailscale ip -4)
valid() {
  [[ "$1" =~ ^100\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
  local a b c d; IFS=. read -r a b c d <<< "$1"
  (( b >= 64 && b <= 127 && c <= 255 && d <= 255 ))
}
valid "$peer" && valid "$node" || fail STUN_PEER_INVALID
[[ $(/usr/sbin/sysctl -n net.ipv4.ip_forward) == 1 ]] || fail STUN_FORWARDING_REQUIRED
{
  if /usr/sbin/nft list table ip gnx_netbird_stun >/dev/null 2>&1; then printf 'delete table ip gnx_netbird_stun\n'; fi
  cat <<EOF
table ip gnx_netbird_stun {
  chain incoming {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "tailscale0" ip daddr $node udp dport 3478 dnat to $peer:3478
  }
  chain local {
    type nat hook output priority dstnat; policy accept;
    ip daddr $node udp dport 3478 dnat to $peer:3478
  }
  chain outgoing {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "tailscale0" ip daddr $peer udp dport 3478 snat to $node
  }
}
EOF
} | /usr/sbin/nft -f - || fail STUN_POLICY_FAILED
