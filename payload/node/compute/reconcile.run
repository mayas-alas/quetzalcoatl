#!/usr/bin/env bash
# External compute lifecycle: never infer an applied release from cache/Quadlet alone.
set -Eeuo pipefail
source_dir=/opt/gnx/payload/node
runtime_dir=/var/lib/gnx-node
receipt="$runtime_dir/compute-applied.sha256"
fail() { printf '{"event":"error","code":"%s"}\n' "$1" >&2; exit 1; }
image_ref() {
  sed -n 's/^Image=//p' "$source_dir/services/compute.container"
}
config_hash() {
  # Only compute-affecting configuration; PWA changes must not bounce guests.
  sha256sum "$source_dir/services/compute.container" \
    "$source_dir/compute/install-tls.sh" "$source_dir/compute/network.run" \
    "$source_dir/compute/guest-network.run" "$source_dir/compute/eth0.network" \
    "$source_dir/compute/gnx-lxc-network.service" "$source_dir/compute/pveproxy-gnx.conf" \
    "$source_dir/compute/pve-firewall-gnx.conf" "$source_dir/compute/pve-guests-gnx.conf" |
    sha256sum | cut -d ' ' -f1
}
read_receipt() { [[ -r "$receipt" ]] && head -n1 "$receipt" || true; }
record_receipt() {
  printf '%s\n' "$1" > "$receipt.new"
  chmod 0644 "$receipt.new"
  mv -f -- "$receipt.new" "$receipt"
}
live_image_matches() {
  local expected actual state
  expected=$(podman image inspect --format '{{.Id}}' "$image" 2>/dev/null) || return 1
  actual=$(podman inspect --format '{{.Image}}' gnx-compute 2>/dev/null) || return 1
  state=$(podman inspect --format '{{.State.Status}}' gnx-compute 2>/dev/null) || return 1
  [[ -n "$expected" && "${expected#sha256:}" == "${actual#sha256:}" && "$state" == running ]]
}
subscription_clean() {
  # pipefail also rejects exec/dpkg failures; absence must not mask a dead guest.
  podman exec gnx-compute /usr/bin/dpkg-query -W -f='${binary:Package}\t${db:Status-Status}\n' 2>/dev/null |
    awk '$1 == "pve-fake-subscription" && $2 == "installed" { bad=1 } END { exit bad }'
}
license_hosts_clean() {
  podman exec gnx-compute /usr/bin/awk '
    /^[[:space:]]*#/ { next }
    { for (i=2; i<=NF && $i !~ /^#/; i++) if (tolower($i) == "shop.maurer-it.com") bad=1 }
    END { exit bad }' /etc/hosts
}
check_compute() {
  cmp -s "$source_dir/services/compute.container" /etc/containers/systemd/compute.container || fail COMPUTE_CONFIG_MISMATCH
  [[ "$(read_receipt)" == "$fingerprint" ]] || fail COMPUTE_UPDATE_PENDING
  live_image_matches || fail COMPUTE_IMAGE_MISMATCH
  subscription_clean || fail COMPUTE_FAKE_SUBSCRIPTION_PRESENT
  license_hosts_clean || fail COMPUTE_LICENSE_HOSTS_BLOCKED
}
apply_compute() {
  local recreate=0
  # Explicit password rotation must recreate the guest to consume EnvironmentFile.
  [[ "${1:-}" == --restart ]] && recreate=1
  [[ "$(read_receipt)" == "$fingerprint" ]] || recreate=1
  cmp -s "$source_dir/services/compute.container" /etc/containers/systemd/compute.container || recreate=1
  live_image_matches || recreate=1
  # This acquires the pinned image before changing the installed configuration.
  bash "$source_dir/compute/install-network.run" || fail COMPUTE_PAYLOAD_INSTALL_FAILED
  install -m 0755 "$source_dir/compute/install-tls.sh" "$runtime_dir/compute-hook/install-tls.sh"
  if ((recreate)); then
    source "$source_dir/services/readiness.run"
    gnx_restart_service compute.service || fail COMPUTE_RESTART_FAILED
  else
    systemctl start compute.service || fail COMPUTE_START_FAILED
  fi
  # Notify=healthy gates systemctl completion. Validate identity and package too.
  live_image_matches || fail COMPUTE_IMAGE_MISMATCH
  subscription_clean || fail COMPUTE_FAKE_SUBSCRIPTION_PRESENT
  license_hosts_clean || fail COMPUTE_LICENSE_HOSTS_BLOCKED
  # Publish acknowledgement only after successful activation; failure remains
  # pending, so a second Retry cannot accidentally adopt the previous container.
  record_receipt "$fingerprint"
  check_compute
}

# Dispatch (also the boundary used by fixture-free behavioral tests).
[[ $(id -u) == 0 ]] || fail ROOT_REQUIRED
image=$(image_ref)
[[ "$image" =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]] || fail COMPUTE_IMAGE_INVALID
fingerprint=$(config_hash)
case "${1:-check}" in
  check) check_compute ;;
  apply)
    [[ $# == 1 || ($# == 2 && "$2" == --restart) ]] || fail INVALID_ARGUMENT
    apply_compute "${2:-}" ;;
  *) fail INVALID_ARGUMENT ;;
esac
