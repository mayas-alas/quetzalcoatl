#!/usr/bin/env python3
"""Read-only check of the guest's resolved tailnet ACL, not a policy editor."""
import ipaddress
import json
import subprocess
import sys


def permits(rules, source, destination, port, protocol):
    def includes(network, address):
        if network == '*':
            return True
        return ipaddress.ip_address(address) in ipaddress.ip_network(network, strict=False)
    for rule in rules:
        protocols = rule.get('IPProto', [])
        if protocols and protocol not in protocols:
            continue
        if not any(includes(s, source) for s in rule.get('SrcIPs', [])):
            continue
        for target in rule.get('DstPorts', []):
            interval = target['Ports']
            if includes(target['IP'], destination) and interval['First'] <= port <= interval['Last']:
                return True
    return False


def main():
    checks = [(443, 6), (1411, 6), (8080, 6), (8081, 6), (3478, 17)]
    try:
        record = '/var/lib/gnx-node/dnsmasq.d/03-rustfs.conf'
        with open(record) as f:
            peer = next(line.strip().split('/')[2] for line in f if line.startswith('address=/netbird.mesh.gnx/'))
        node = subprocess.check_output(['podman', 'exec', 'gnx-mesh', 'tailscale', 'ip', '-4'], text=True, timeout=10).strip()
        for ip in (node, peer):
            assert ipaddress.ip_address(ip) in ipaddress.ip_network('100.64.0.0/10')
        vmid = subprocess.check_output(['podman', 'exec', 'gnx-compute', 'pvesh', 'get', '/cluster/resources', '--type', 'vm', '--output-format', 'json'], text=True, timeout=10)
        owned = [v['vmid'] for v in json.loads(vmid) if v.get('type') == 'lxc' and 'gnx-rustfs' in v.get('tags', '').split(';')]
        assert len(owned) == 1
        result = subprocess.run(['podman', 'exec', 'gnx-compute', 'pct', 'exec', str(owned[0]), '--', 'podman', 'exec', 'gnx-workload-mesh', 'tailscale', '--socket=/var/lib/tailscale/tailscaled.sock', 'debug', 'netmap'], capture_output=True, check=True, timeout=10)
        rules = json.loads(result.stdout)['PacketFilterRules']
        gateway = subprocess.run(['podman', 'exec', 'gnx-mesh', 'tailscale', 'debug', 'netmap'], capture_output=True, check=True, timeout=10)
        gateway_rules = json.loads(gateway.stdout)['PacketFilterRules']
        failed = False
        for port, protocol in checks:
            ok = permits(rules, node, peer, port, protocol)
            failed |= not ok
            print(json.dumps({'check': 'access_mesh_' + ('tcp_' if protocol == 6 else 'udp_') + str(port), 'result': 'pass' if ok else 'fail'}))
        # Combined server must resolve the private issuer and reach Caddy for
        # OIDC discovery and its own public WebSocket relay health check.
        for port, protocol in [(53, 6), (53, 17), (443, 6)]:
            ok = permits(gateway_rules, peer, node, port, protocol)
            failed |= not ok
            print(json.dumps({'check': 'access_mesh_gateway_' + ('tcp_' if protocol == 6 else 'udp_') + str(port), 'result': 'pass' if ok else 'fail'}))
        if failed:
            print(json.dumps({'event': 'error', 'code': 'ACCESS_MESH_POLICY_REQUIRED'}), file=sys.stderr)
        return int(failed)
    except (OSError, ValueError, KeyError, TypeError, StopIteration, AssertionError, subprocess.SubprocessError):
        print(json.dumps({'event': 'error', 'code': 'ACCESS_MESH_POLICY_UNAVAILABLE'}), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
