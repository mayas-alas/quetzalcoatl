#!/usr/bin/env bash
# Build-time preparation derived from dockur/proxmox e18ddeb8 (MIT).
# No subscription forgery or UI modification. Never run on an enrolled host.
set -Eeuo pipefail
apt-get update
apt-get install -y --no-install-recommends \
  bc jq curl dbus nano wget sudo htop less cpio gosu iotop gnupg procps chrony \
  ipcalc postfix ethtool dnsmasq dnsutils sysstat locales iptables iproute2 \
  ifupdown2 jfsutils xfsprogs e2fsprogs net-tools nfs-common cifs-utils traceroute \
  open-iscsi btrfs-progs bridge-utils iputils-ping netcat-openbsd ca-certificates isc-dhcp-client

echo '136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45  /usr/share/keyrings/proxmox-archive-keyring.gpg' | sha256sum --check --status
printf '%s\n' 'Types: deb' 'URIs: http://download.proxmox.com/debian/pve' \
  'Suites: trixie' 'Components: pve-no-subscription' \
  'Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg' > /etc/apt/sources.list.d/pve.sources
printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d
chmod +x /usr/sbin/policy-rc.d
# Upstream build-only stubs: systemd is PID1 at runtime, not during apt install.
dpkg-divert --local --rename --add /usr/bin/unshare
printf '#!/bin/sh\nwhile [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done\n[ "$1" = "--" ] && shift\n[ $# -gt 0 ] && exec "$@"\nexit 0\n' > /usr/bin/unshare
chmod +x /usr/bin/unshare
dpkg-divert --local --rename --add /usr/sbin/update-initramfs
printf '#!/bin/sh\nexit 0\n' > /usr/sbin/update-initramfs
chmod +x /usr/sbin/update-initramfs
dpkg-divert --local --rename --add /usr/sbin/ifreload
printf '#!/bin/sh\n[ "$1" = "-V" ] && printf "%%s\n" "ifupdown2:3.3.0-1+pmx12"\nexit 0\n' > /usr/sbin/ifreload
chmod +x /usr/sbin/ifreload
printf '#!/bin/sh\nexit 0\n' > /usr/local/sbin/systemctl
chmod +x /usr/local/sbin/systemctl
mkdir -p /usr/share/doc/pve-manager
touch /usr/share/doc/pve-manager/aplinfo.dat
apt-get update
apt-get install -y --no-install-recommends proxmox-ve
rm -f /etc/apt/sources.list.d/pve-enterprise.list /etc/apt/sources.list.d/pve-enterprise.sources \
  /etc/apt/sources.list.d/ceph.list /etc/apt/sources.list.d/ceph.sources
apt-mark hold proxmox-ve
apt-get remove -y os-prober >/dev/null
SUDO_FORCE_REMOVE=yes apt-get remove -y sudo
apt-get autoremove -y
apt-get clean
locale-gen en_US.UTF-8
ln -sf /dev/null /etc/systemd/system/watchdog-mux.service
ln -sf /dev/null /etc/systemd/system/systemd-networkd-wait-online.service
printf '[Unit]\nDescription=Keyboard Request Target\n\n[Target]\n' > /etc/systemd/system/kbrequest.target
mkdir -p /etc/systemd/system/ifupdown2-pre.service.d
printf '[Service]\nExecStart=\nExecStart=/bin/true\n' > /etc/systemd/system/ifupdown2-pre.service.d/override.conf
# pveam verification keys, unchanged from upstream.
gpg --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys \
  A7BCD1420BFE778E 85C25E95A16EB94D 39DE63C7D57A32124785E63DB859507D6B1F46D3
gpg --export A7BCD1420BFE778E 85C25E95A16EB94D 39DE63C7D57A32124785E63DB859507D6B1F46D3 \
  > /usr/share/doc/pve-manager/trustedkeys.gpg
rm -rf /root/.gnupg
sed -i 's/^ConditionVirtualization=!container/#&/' /lib/systemd/system/lxcfs.service
echo 'LISTEN_IP="0.0.0.0"' >> /etc/default/pveproxy
sed -i 's|https://${urlip}:8006/|http://127.0.0.1:8006|g' /usr/bin/pvebanner
sed -i 's|https://${localip}:8006/|http://127.0.0.1:8006|g' /usr/bin/pvebanner
sed -i "s|the Proxmox Virtual Environment\.|Proxmox for Docker v${VERSION_ARG}.|g" /usr/bin/pvebanner
rm -rf /usr/lib/modules /usr/lib/firmware
find /boot -mindepth 1 -delete
rm -f /usr/lib/*/libLLVM*.so* /usr/lib/*/libgallium*.so* /usr/lib/*/libvulkan_*.so* \
  /usr/lib/*/libz3.so* /usr/lib/*/libx265.so* /usr/lib/*/libcodec2.so* /usr/lib/*/libavcodec.so* \
  /usr/lib/*/libavfilter.so* /usr/lib/*/libSvtAv1Enc.so* /usr/lib/*/libplacebo.so*
rm -rf /usr/lib/*/dri /usr/lib/*/gstreamer-1.0 /usr/share/pocketsphinx /usr/share/X11 \
  /usr/share/alsa /usr/share/fonts /usr/share/grub /usr/share/groff /usr/share/mime /usr/share/man
# Preserve upstream first-boot semantics; the product supplies PASSWORD via its
# protected EnvironmentFile and never uses the image default for enrollment.
echo 'root:root' | chpasswd
printf '%s\n' "$VERSION_ARG" > /etc/version
rm /usr/local/sbin/systemctl
rm -rf /tmp/* /var/tmp/* /var/lib/apt/lists/*
# Assert absence at build time, before the filesystem becomes an image layer.
! dpkg-query -W -f='${db:Status-Status}\n' pve-fake-subscription 2>/dev/null | grep -qx installed
