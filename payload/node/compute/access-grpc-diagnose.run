#!/usr/bin/env python3
"""Read-only gRPC diagnostics; output only protocol/status metadata, never bodies."""
import json
import subprocess

ca = '/var/lib/gnx-node/ca/gateway-ca.pem'
for service, path in [('management', '/management.ManagementService/GetServerKey'),
                      ('signal', '/signalexchange.SignalExchange/Send')]:
    r = subprocess.run(['curl', '--http2', '--silent', '--show-error', '--max-time', '10',
                        '--cacert', ca, '--resolve', 'netbird.gnx:443:127.0.0.1',
                        '-H', 'Content-Type: application/grpc', '-H', 'TE: trailers',
                        '--data-binary', '@-', '-D', '-', '-o', '/dev/null',
                        'https://netbird.gnx' + path], input=b'\0\0\0\0\0', capture_output=True)
    metadata = {'grpc_service': service, 'curl_exit': r.returncode}
    for line in r.stdout.decode(errors='replace').splitlines():
        if line.startswith('HTTP/'):
            parts = line.split()
            metadata['http_version'] = parts[0]
            metadata['http_status'] = parts[1] if len(parts) > 1 else 'missing'
            metadata['http_status_line_repr'] = repr(line)
        elif line.lower().startswith('grpc-status:'):
            value = line.split(':', 1)[1].strip()
            metadata['grpc_status'] = value if value.isdigit() else 'invalid'
        elif line.lower().startswith('content-type:'):
            metadata['grpc_content_type'] = 'application/grpc' in line.lower()
    if r.returncode:
        error = r.stderr.decode(errors='replace').lower()
        metadata['error_category'] = 'http2_unsupported' if 'http2' in error else 'tls' if 'ssl' in error else 'transport'
    print(json.dumps(metadata))
