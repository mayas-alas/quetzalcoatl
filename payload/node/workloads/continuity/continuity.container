[Unit]
Description=Continuity business journal
After=workload-mesh-guard.service
Requires=workload-mesh-guard.service

[Container]
Image=localhost/continuity@sha256:4b9067a1a38a8d2175a8aa27713aaf3d13003d0aaa73120220c8df16ec0ca604
Pull=never
ContainerName=continuity-business
Network=continuity.network
IP=10.89.60.10
User=10001:10001
Exec=serve
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Volume=/var/lib/continuity-business:/data
Volume=/var/lib/gnx/continuity/tls/ca.crt:/run/continuity/s3-ca.crt:ro
EnvironmentFile=/var/lib/gnx/continuity/secrets/s3.env
Environment=CONTINUITY_DATA_DIR=/data
Environment=CONTINUITY_SCOPE=business
Environment=CONTINUITY_LISTEN=0.0.0.0:7310
Environment=CONTINUITY_ACK=remote
Environment=CONTINUITY_S3_ENDPOINT=https://rustfs.gnx
Environment=CONTINUITY_S3_CONNECT_ADDR=10.88.0.1:443
Environment=CONTINUITY_S3_BUCKET=continuity
Environment=CONTINUITY_S3_PREFIX=continuity/business
Environment=CONTINUITY_S3_REGION=us-east-1
Environment=CONTINUITY_S3_ACCESS_KEY_ENV=STORE_ACCESS_KEY
Environment=CONTINUITY_S3_SECRET_KEY_ENV=STORE_SECRET_KEY
Environment=CONTINUITY_S3_CA_CERT=/run/continuity/s3-ca.crt
Environment=CONTINUITY_MAX_EVENTS=10000
Environment=CONTINUITY_MAX_BODY_BYTES=262144
Environment=CONTINUITY_MAX_EVENT_BYTES=16384
Environment=CONTINUITY_MAX_BATCH=100
PublishPort=7310:7310
PodmanArgs=--memory=384m --cpus=1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
