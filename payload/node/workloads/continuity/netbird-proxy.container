[Unit]
Description=Continuity account-scoped NetBird BYOP
After=workload-mesh-guard.service
Requires=workload-mesh-guard.service

[Container]
Image=localhost/gnx/netbird-proxy@sha256:735c68a60624c72c315e7c3612bfe760f8c75251cf327afd2b5e0a60c9cdab6e
Pull=never
ContainerName=gnx-netbird-proxy
Network=continuity.network
IP=10.89.60.20
User=1000:1000
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,nosuid,nodev,size=64m
Volume=/var/lib/gnx/continuity/proxy:/var/lib/netbird
Volume=/var/lib/gnx/continuity/tls:/certs:ro
EnvironmentFile=/var/lib/gnx/continuity/secrets/proxy.env
Environment=NB_PROXY_MANAGEMENT_ADDRESS=https://netbird.gnx
Environment=NB_PROXY_DOMAIN=proxy.gnx
Environment=NB_PROXY_ADDRESS=:8443
Environment=NB_PROXY_HEALTH_ADDRESS=:18080
Environment=NB_PROXY_PRIVATE=true
Environment=NB_PROXY_CERTIFICATE_DIRECTORY=/certs
Environment=NB_PROXY_CERTIFICATE_FILE=tls.crt
Environment=NB_PROXY_CERTIFICATE_KEY_FILE=tls.key
Environment=NB_PROXY_WILDCARD_CERT_DIR=/certs
Environment=NB_PROXY_ACME_CERTIFICATES=false
Environment=NB_PROXY_LOG_LEVEL=warn
Environment=SSL_CERT_FILE=/certs/ca.crt
Environment=NB_STATE_DIR=/var/lib/netbird
Environment=NB_DISABLE_GEOLOCATION=true
Environment=NB_PROXY_SUPPORTS_CUSTOM_PORTS=false
Environment=NB_PROXY_TRUSTED_PROXIES=10.88.0.1/32
PublishPort=8443:8443
PublishPort=127.0.0.1:18080:18080
AddHost=netbird.gnx:10.88.0.1
PodmanArgs=--memory=512m --cpus=1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
