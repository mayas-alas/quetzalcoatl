  "services": {"voice": {"ip": "10.89.50.10", "port": 18000}, "oryx": {"ip": "10.89.50.20", "port": 2022}, "omniroute": {"ip": "10.89.50.30", "port": 20128}, "continuity": {"ip": "10.89.50.40", "port": 7310}, "netbird-proxy": {"ip": "10.89.50.50", "port": 8443}},
  "continuity": {"scope": "ai", "bucket": "continuity", "prefix": "continuity/ai", "ack": "remote"},
  "public_ingress": false
