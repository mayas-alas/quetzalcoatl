  "network": {"subnet": "10.89.50.0/24", "gateway": "10.89.50.1", "compute_gateway": "10.88.0.1", "quadlet": "ai.network", "guard_unit": "workload-mesh-guard.service"},
  "mesh": {"hostname": "gnx-ai", "container_name": "gnx-ai-mesh", "quadlet": "workload-mesh.container", "state_dir": "/var/lib/gnx/ai/mesh", "guard_policy": "/opt/gnx/workloads/ai/mesh.nft", "enrollment_key_file": "/var/lib/gnx/ai/mesh/enrollment.key", "copy_existing_identity": false},
