[Unit]
Description=GnX Voice on dedicated AI machine
After=workload-mesh-guard.service
Requires=workload-mesh-guard.service

[Container]
Image=localhost/gnx/voice@sha256:2b19b2c24a2f83e87d175f8b4fc3f882ad2a596b53451de98d4752a43e0a6350
Pull=never
ContainerName=gnx-voice
Network=ai.network
IP=10.89.50.10
User=10001:10001
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,nodev,size=64m
Volume=/var/lib/gnx/ai/secrets/voice:/run/gnx/voice:ro
Volume=/var/lib/gnx/ai/tls/ca.crt:/run/gnx/ca.crt:ro
Environment=BIND_HOST=0.0.0.0
Environment=PORT=18000
Environment=APP_ORIGIN=https://voice.ai.gnx
Environment=GNX_API_TOKEN_FILE=/run/gnx/voice/api.token
Environment=NODE_EXTRA_CA_CERTS=/run/gnx/ca.crt
Environment=VOICE_ENABLED=false
Environment=ORYX_BASE_URL=http://10.89.50.20:2022
Environment=ORYX_PUBLIC_BASE_URL=https://oryx.ai.gnx
Environment=OMNIROUTE_BASE_URL=http://10.89.50.30:20128/v1
Environment=CONTINUITY_BASE_URL=http://10.89.50.40:7310
PodmanArgs=--memory=384m --cpus=1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
