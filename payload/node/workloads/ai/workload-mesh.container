[Unit]
Description=GnX AI guest mesh transport
Requires=workload-mesh-guard.service
After=workload-mesh-guard.service network-online.target
Before=voice.service oryx.service omniroute.service continuity.service netbird-proxy.service

[Container]
Image=localhost/gnx/workload-mesh@sha256:b6d8956b30e9fd5c6077f24454c5f772f6c4b7754373cd82c0350b5aa6c83f96
Pull=never
ContainerName=gnx-ai-mesh
Network=host
User=65532:65532
DropCapability=all
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddDevice=/dev/net/tun
NoNewPrivileges=true
PodmanArgs=--memory=256m --cpus=1 --hostname=gnx-ai --entrypoint=/usr/local/bin/tailscaled
Volume=/var/lib/gnx/ai/mesh:/var/lib/tailscale:Z
Exec=--state=/var/lib/tailscale/tailscaled.state --socket=/var/lib/tailscale/tailscaled.sock --tun=tailscale0 --port=41641

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=90s

[Install]
WantedBy=multi-user.target

