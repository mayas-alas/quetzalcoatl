#!/usr/bin/env python3
"""Guest-local BYOP enrollment against the EXISTING NetBird management.

Run inside private-services, never the Windows/public PWA boundary. Fixed local
API and protected product state; no token/password/domain accepted through argv.
The account token is NOT the management-wide proxy token. Caddy stays the edge.
"""
import json
import os
import re
import stat
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

BASE = Path('/var/lib/gnx/access')
API = 'http://127.0.0.1:8081/api/reverse-proxies/'


class Blocked(Exception):
    pass


def private(path):
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o600:
        raise Blocked('AI_PROXY_SECRET_PERMISSIONS')
    return path.read_text()


def persist(path, value):
    # Creation only. Never overwrite enrollment identity or recover a lost token
    # by silently minting another token. No symlink following.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(value)
        f.flush()
        os.fsync(f.fileno())
    parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(parent)
    finally:
        os.close(parent)


def domain(value):
    if not isinstance(value, str) or len(value) > 253:
        raise Blocked('AI_PROXY_DOMAIN_INVALID')
    value = value.lower().rstrip('.')
    labels = value.split('.')
    if len(labels) < 2 or any(not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', x) for x in labels):
        raise Blocked('AI_PROXY_DOMAIN_INVALID')
    if labels[-1].isdigit():
        raise Blocked('AI_PROXY_DOMAIN_INVALID')
    return value


def request(method, path, pat, body=None):
    req = urllib.request.Request(API + path, method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Authorization': 'Token ' + pat, 'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            raw = response.read(1048577)
            if len(raw) > 1048576:
                raise Blocked('AI_PROXY_API_RESPONSE_LIMIT')
            value = json.loads(raw) if raw else None
            if method == 'GET' and path in ('proxy-tokens', 'clusters', 'domains'):
                if not isinstance(value, list) or any(not isinstance(x, dict) for x in value):
                    raise Blocked('AI_PROXY_API_RESPONSE_INVALID')
            if method == 'POST' and not isinstance(value, dict):
                raise Blocked('AI_PROXY_API_RESPONSE_INVALID')
            return value
    except urllib.error.HTTPError as error:
        # Do not serialize API response bodies, request headers or credentials.
        raise Blocked('AI_PROXY_API_HTTP_' + str(error.code)) from None


def config():
    data = json.loads(private(BASE / 'ai-proxy-config.json'))
    if not isinstance(data, dict) or set(data) != {'cluster_domain', 'custom_domain'}:
        raise Blocked('AI_PROXY_CONFIG_INVALID')
    return {key: domain(value) for key, value in data.items()}


def token(pat, cfg):
    intent_path = BASE / 'ai-proxy-intent.json'
    secret_path = BASE / 'ai-proxy.env'
    receipt_path = BASE / 'ai-proxy-token.json'
    if not intent_path.exists():
        import secrets
        persist(intent_path, json.dumps({'name': 'gnx-ai-' + secrets.token_hex(8), **cfg}))
    intent = json.loads(private(intent_path))
    if not isinstance(intent, dict) or {key: intent.get(key) for key in cfg} != cfg or not re.fullmatch(r'gnx-ai-[0-9a-f]{16}', intent.get('name', '')):
        raise Blocked('AI_PROXY_OWNERSHIP_CONFLICT')
    current = request('GET', 'proxy-tokens', pat)
    matches = [x for x in current if x.get('name') == intent['name']]
    if receipt_path.exists():
        receipt = json.loads(private(receipt_path))
        if not isinstance(receipt, dict) or len(matches) != 1 or matches[0].get('id') != receipt.get('id') or matches[0].get('revoked'):
            raise Blocked('AI_PROXY_TOKEN_REVOKED_OR_MISSING')
        value = private(secret_path).strip()
        if not re.fullmatch(r'NB_PROXY_TOKEN=nbx_[A-Za-z0-9_-]+', value):
            raise Blocked('AI_PROXY_TOKEN_FORMAT_INVALID')
        return
    if matches or secret_path.exists():
        # POST succeeded but plaintext/receipt was not durably saved. Tokens
        # are returned once; recovery must be explicit, not an automatic rotate.
        raise Blocked('AI_PROXY_TOKEN_RECOVERY_REQUIRED')
    created = request('POST', 'proxy-tokens', pat, {'name': intent['name'], 'expires_in': 0})
    plain = created.get('plain_token', '')
    if not re.fullmatch(r'nbx_[A-Za-z0-9_-]+', plain) or not re.fullmatch(r'[A-Za-z0-9_-]+', created.get('id', '')):
        raise Blocked('AI_PROXY_TOKEN_RESPONSE_INVALID')
    persist(secret_path, 'NB_PROXY_TOKEN=' + plain + '\n')
    persist(receipt_path, json.dumps({'id': created['id']}))


def cluster(pat, cfg):
    matches = [x for x in request('GET', 'clusters', pat) if x.get('address') == cfg['cluster_domain']]
    if len(matches) != 1 or matches[0].get('type') != 'account':
        raise Blocked('AI_PROXY_ACCOUNT_CLUSTER_REQUIRED')
    entry = matches[0]
    if not entry.get('online') or entry.get('connected_proxies', 0) < 1:
        raise Blocked('AI_PROXY_CLUSTER_OFFLINE')
    return entry


def domains(pat, cfg):
    cluster(pat, cfg)
    receipt_path = BASE / 'ai-proxy-domain.json'
    if receipt_path.exists():
        receipt = json.loads(private(receipt_path))
    else:
        entries = request('GET', 'domains', pat)
        if any(x.get('domain') == cfg['custom_domain'] for x in entries):
            raise Blocked('AI_PROXY_DOMAIN_UNOWNED')
        # The API's CNAME lookup must succeed independently of Caddy routing.
        # No endpoint exists for bypassing verification; do not fabricate it.
        created = request('POST', 'domains', pat,
                          {'domain': cfg['custom_domain'], 'target_cluster': cfg['cluster_domain']})
        if (not re.fullmatch(r'[A-Za-z0-9_-]+', created.get('id', '')) or
            created.get('domain') != cfg['custom_domain'] or created.get('target_cluster') != cfg['cluster_domain']):
            raise Blocked('AI_PROXY_DOMAIN_RESPONSE_INVALID')
        receipt = {'id': created['id'], **cfg}
        persist(receipt_path, json.dumps(receipt))
    if not isinstance(receipt, dict) or {key: receipt.get(key) for key in cfg} != cfg or not re.fullmatch(r'[A-Za-z0-9_-]+', receipt.get('id', '')):
        raise Blocked('AI_PROXY_DOMAIN_OWNERSHIP_CONFLICT')
    request('GET', 'domains/' + receipt['id'] + '/validate', pat)
    for _ in range(15):
        entries = request('GET', 'domains', pat)
        match = [x for x in entries if x.get('id') == receipt['id'] and x.get('domain') == cfg['custom_domain']]
        if len(match) == 1 and match[0].get('validated') and match[0].get('target_cluster') == cfg['cluster_domain']:
            return
        time.sleep(1)
    raise Blocked('AI_PROXY_DOMAIN_VERIFICATION_REQUIRED')


def verify(pat, cfg):
    cluster(pat, cfg)
    receipt = json.loads(private(BASE / 'ai-proxy-domain.json'))
    if not isinstance(receipt, dict) or {key: receipt.get(key) for key in cfg} != cfg:
        raise Blocked('AI_PROXY_DOMAIN_OWNERSHIP_CONFLICT')
    entries = request('GET', 'domains', pat)
    if not any(x.get('id') == receipt.get('id') and x.get('domain') == cfg['custom_domain'] and
               x.get('type') == 'custom' and x.get('validated') and
               x.get('target_cluster') == cfg['cluster_domain'] for x in entries):
        raise Blocked('AI_PROXY_DOMAIN_VERIFICATION_REQUIRED')


def main():
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ('token', 'domains', 'verify'):
        raise Blocked('AI_PROXY_ARGUMENT_INVALID')
    os.umask(0o077)
    st = BASE.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        raise Blocked('AI_PROXY_STATE_PERMISSIONS')
    cfg = config()
    pat = json.loads(private(BASE / 'netbird-enrollment.json'))['token']
    {'token': token, 'domains': domains, 'verify': verify}[sys.argv[1]](pat, cfg)
    # This is enrollment evidence, not application/TLS/tunnel/audio readiness.
    print(json.dumps({'event': 'ai_proxy_' + sys.argv[1], 'cluster_type': 'account'}))


if __name__ == '__main__':
    try:
        main()
    except Blocked as error:
        print(json.dumps({'event': 'error', 'code': str(error)}), file=sys.stderr)
        raise SystemExit(1)
    except (OSError, ValueError, KeyError, TypeError, urllib.error.URLError):
        print('{"event":"error","code":"AI_PROXY_ENROLL_FAILED"}', file=sys.stderr)
        raise SystemExit(1)
