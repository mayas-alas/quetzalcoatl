[Unit]
Description=GnX Continuity AI journal
After=workload-mesh-guard.service
Requires=workload-mesh-guard.service

[Container]
Image=localhost/continuity@sha256:f5cbdbe57d3e34341f00c902db72123d8f6cfd1408d9dc567c729bff735e8884
Pull=never
ContainerName=gnx-continuity-ai
Network=ai.network
IP=10.89.50.40
User=10001:10001
Exec=serve
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Volume=/var/lib/continuity-ai:/data
Volume=/var/lib/gnx/ai/tls/ca.crt:/run/gnx/s3-ca.crt:ro
EnvironmentFile=/var/lib/gnx/ai/secrets/s3.env
Environment=CONTINUITY_DATA_DIR=/data
Environment=CONTINUITY_SCOPE=ai
Environment=CONTINUITY_LISTEN=0.0.0.0:7310
Environment=CONTINUITY_ACK=remote
Environment=CONTINUITY_S3_ENDPOINT=https://rustfs.gnx
Environment=CONTINUITY_S3_BUCKET=continuity
Environment=CONTINUITY_S3_PREFIX=continuity/ai
Environment=CONTINUITY_S3_REGION=us-east-1
Environment=CONTINUITY_S3_ACCESS_KEY_ENV=STORE_ACCESS_KEY
Environment=CONTINUITY_S3_SECRET_KEY_ENV=STORE_SECRET_KEY
Environment=CONTINUITY_S3_CA_CERT=/run/gnx/s3-ca.crt
Environment=CONTINUITY_MAX_EVENTS=10000
Environment=CONTINUITY_MAX_BODY_BYTES=262144
Environment=CONTINUITY_MAX_EVENT_BYTES=16384
Environment=CONTINUITY_MAX_BATCH=100
PodmanArgs=--memory=384m --cpus=1 --add-host=rustfs.gnx:10.88.0.1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
