[Unit]
Description=GnX Oryx media service
After=workload-mesh-guard.service
Requires=workload-mesh-guard.service

[Container]
Image=localhost/gnx/oryx@sha256:58bcf5453705b7138a291e8761c8fec627c6c982a92532c732a384eeb0ee6bf4
Pull=never
ContainerName=gnx-oryx
Network=ai.network
IP=10.89.50.20
NoNewPrivileges=true
Volume=/var/lib/gnx/ai/oryx:/data
EnvironmentFile=/var/lib/gnx/ai/secrets/oryx.env
PodmanArgs=--memory=768m --cpus=1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
