# The combined server includes Management/Signal/Relay/STUN, not the web UI.
[Unit]
Description=GnX NetBird dashboard (upstream rootless image)
After=netbird-server.service workload-mesh-guard.service
Requires=netbird-server.service workload-mesh-guard.service

[Container]
Image=localhost/gnx/netbird-dashboard@sha256:6017cf531c27a307a1f3149a7a1fa2a3bd41b85e6382088e2b83eff455085562
ContainerName=gnx-netbird-dashboard
Pull=never
Network=host
User=10001:0
DropCapability=all
NoNewPrivileges=true
Environment=NETBIRD_MGMT_API_ENDPOINT=https://netbird.gnx
Environment=NETBIRD_MGMT_GRPC_API_ENDPOINT=https://netbird.gnx
Environment=AUTH_AUTHORITY=https://netbird.gnx/oauth2
Environment=AUTH_CLIENT_ID=netbird-dashboard
Environment=AUTH_AUDIENCE=netbird-dashboard
Environment="AUTH_SUPPORTED_SCOPES=openid profile email groups"
Environment=AUTH_REDIRECT_URI=/nb-auth
Environment=AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
Environment=USE_AUTH0=false
Environment=LETSENCRYPT_DOMAIN=none
HealthCmd=/usr/bin/wget -q --spider --timeout=5 http://127.0.0.1:8080/
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=3min
TimeoutStopSec=1min

[Install]
WantedBy=multi-user.target
