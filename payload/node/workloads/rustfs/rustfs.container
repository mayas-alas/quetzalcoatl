[Unit]
Description=GnX RustFS object storage
After=workload-mesh.service workload-mesh-guard.service
Requires=workload-mesh.service workload-mesh-guard.service

[Container]
Image=localhost/gnx/rustfs:1.0.0-gnx.1
ContainerName=gnx-rustfs
Pull=never
Network=host
User=10001:10001
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
EnvironmentFile=/var/lib/gnx/rustfs/rustfs.env
# The guest guard permits dashboard ingress only through the mesh interface.
# Native RustFS TLS serves our hostname/CA, not a tailscale.net certificate.
Environment=RUSTFS_ADDRESS=127.0.0.1:9000
Environment=RUSTFS_CONSOLE_ADDRESS=0.0.0.0:443
Environment=RUSTFS_CONSOLE_ENABLE=true
Environment=RUSTFS_BROWSER_REDIRECT_URL=https://rustfs.gnx/rustfs/console/
Environment=RUSTFS_TLS_PATH=/certs
Volume=/var/lib/gnx/rustfs/tls:/certs:ro,Z
Volume=/var/lib/gnx/rustfs/data:/data:Z,U
Volume=/var/lib/gnx/rustfs/logs:/logs:Z,U
HealthCmd=/usr/bin/curl --fail --silent --connect-timeout 2 --max-time 5 --cacert /certs/ca.crt --resolve rustfs.gnx:9000:127.0.0.1 https://rustfs.gnx:9000/minio/health/live
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=90s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=5min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
