[Unit]
Description=GnX guest fail-closed mesh egress guard
Before=network-pre.target workload-mesh.service rustfs.service
Wants=network-pre.target
After=local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/gnx-workload-mesh guard
RemainAfterExit=yes
# No ExecStop: stopping a unit must never remove the guard.

[Install]
WantedBy=multi-user.target
