#!/usr/bin/env bash
# Idempotent RustFS installer for the managed LXC. Compatible with Podman 6+;
# the minimum remains 4.9 so supported distro packages are not replaced by curl.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
die() { printf '{"event":"error","code":"%s"}\n' "$1" >&2; exit 1; }
[[ "$(id -u)" == 0 ]] || die ROOT_REQUIRED
[[ $# == 0 || ( $# == 1 && "$1" == --prepare ) ]] || die INVALID_ARGUMENT
# Never leave an older unguarded service running when reconciliation blocks.
if systemctl is-active --quiet rustfs.service; then
  systemctl stop rustfs.service >/dev/null || die WORKLOAD_STOP_FAILED
fi
# Only the verified release bundle supplies dependencies/images, never guest egress.
install -d -m 0755 /var/lib/gnx/rustfs
bundle_digest=$(sha256sum /opt/gnx/workloads/rustfs/offline.tar.gz | awk '{print $1}') || die OFFLINE_BOOTSTRAP_REQUIRED
if [[ ! -r /var/lib/gnx/rustfs/offline.sha256 || $(< /var/lib/gnx/rustfs/offline.sha256) != "$bundle_digest" ]]; then
  tar -xzf /opt/gnx/workloads/rustfs/offline.tar.gz -C /opt/gnx/workloads/rustfs
  DEBIAN_FRONTEND=noninteractive dpkg -i /opt/gnx/workloads/rustfs/packages/*.deb >/dev/null || die OFFLINE_PACKAGE_INSTALL_FAILED
  podman load -i /opt/gnx/workloads/rustfs/tailscale.tar >/dev/null || die OFFLINE_MESH_IMAGE_REQUIRED
  podman load -i /opt/gnx/workloads/rustfs/rustfs.tar >/dev/null || die OFFLINE_WORKLOAD_IMAGE_REQUIRED
  printf '%s\n' "$bundle_digest" > /var/lib/gnx/rustfs/offline.sha256
  rm -rf /opt/gnx/workloads/rustfs/packages /opt/gnx/workloads/rustfs/tailscale.tar /opt/gnx/workloads/rustfs/rustfs.tar
fi
for tool in podman nft jq curl openssl; do
  command -v "$tool" >/dev/null 2>&1 || die OFFLINE_BOOTSTRAP_REQUIRED
done
[[ -c /dev/net/tun ]] || die GUEST_TUN_REQUIRED
version=$(podman version --format '{{.Client.Version}}' 2>/dev/null || true)
[[ "$version" =~ ^([0-9]+)\.([0-9]+)\. ]] || die PODMAN_VERSION_INVALID
((10#${BASH_REMATCH[1]} > 4 || (10#${BASH_REMATCH[1]} == 4 && 10#${BASH_REMATCH[2]} >= 9))) || die PODMAN_VERSION_UNSUPPORTED
install -d -m 0755 /etc/containers/systemd
install -d -m 0755 -o 10001 -g 10001 /var/lib/gnx/rustfs/data /var/lib/gnx/rustfs/logs
# Migrate only this workload's fixed volumes; preserve contents, do not follow
# symlinks. The unprivileged RustFS principal must be able to write existing data.
chown -R -P --no-dereference 10001:10001 /var/lib/gnx/rustfs/data /var/lib/gnx/rustfs/logs
install -d -m 0700 -o 65532 -g 65532 /var/lib/gnx/mesh
install -m 0755 /opt/gnx/workloads/rustfs/mesh.run /usr/local/libexec/gnx-workload-mesh
install -m 0644 /opt/gnx/workloads/rustfs/workload-mesh-guard.service /etc/systemd/system/workload-mesh-guard.service
install -d -m 0755 /etc/systemd/system/systemd-networkd.service.d
install -m 0644 /opt/gnx/workloads/rustfs/networkd-mesh-guard.conf /etc/systemd/system/systemd-networkd.service.d/gnx-mesh-guard.conf
install -m 0644 /opt/gnx/workloads/rustfs/workload-mesh.container /etc/containers/systemd/workload-mesh.container
systemctl daemon-reload
systemctl enable --now workload-mesh-guard.service >/dev/null || die MESH_GUARD_FAILED
podman image exists localhost/gnx/workload-mesh@sha256:b6d8956b30e9fd5c6077f24454c5f772f6c4b7754373cd82c0350b5aa6c83f96 || die OFFLINE_MESH_IMAGE_REQUIRED
# Preparation is entirely offline; the caller may release the host bridge gate
# only after this succeeds. Enrollment/exit selection precedes full install.
[[ "${1:-}" != --prepare ]] || exit 0
systemctl start workload-mesh.service >/dev/null || die MESH_START_FAILED
# Await native startup after a cold boot; no exit-node lease is needed.
for _ in {1..30}; do
  /usr/local/libexec/gnx-workload-mesh status | jq -e '.mesh == true' >/dev/null && break
  sleep 1
done
/usr/local/libexec/gnx-workload-mesh status | jq -e '.mesh == true' >/dev/null || die WORKLOAD_MESH_NOT_READY
if [[ ! -s /var/lib/gnx/rustfs/rustfs.env ]]; then
  access=$(openssl rand -hex 16)
  secret=$(openssl rand -hex 32)
  printf 'RUSTFS_ACCESS_KEY=%s\nRUSTFS_SECRET_KEY=%s\n' "$access" "$secret" > /var/lib/gnx/rustfs/rustfs.env.new
  unset access secret
  chmod 0600 /var/lib/gnx/rustfs/rustfs.env.new
  mv /var/lib/gnx/rustfs/rustfs.env.new /var/lib/gnx/rustfs/rustfs.env
fi
podman build --pull=never --tag localhost/gnx/rustfs:1.0.0-gnx.1 /opt/gnx/workloads/rustfs >/dev/null || die IMAGE_BUILD_FAILED
install -m 0644 /opt/gnx/workloads/rustfs/rustfs.container /etc/containers/systemd/rustfs.container
systemctl daemon-reload
systemctl start rustfs.service >/dev/null || die SERVICE_START_FAILED
for _ in $(seq 1 90); do
  if systemctl is-active --quiet rustfs.service && podman healthcheck run gnx-rustfs >/dev/null 2>&1; then
    /usr/local/libexec/gnx-workload-mesh https || die MESH_HTTPS_NOT_READY
    printf '%s\n' '{"event":"ready","workload":"rustfs","version":"1.0.0-gnx.1"}'
    exit 0
  fi
  sleep 2
done
die HEALTHCHECK_FAILED
