#!/usr/bin/env python3
"""One-time GnX-owned OIDC linking. No secret in argv, stdout or browser assets.

Fresh NetBird gets a randomly generated local break-glass owner; existing accounts
are never reset/adopted. The operator still enrolls their own Pocket ID passkey.
"""
import json
import os
import secrets
import stat
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

os.umask(0o077)
BASE = Path('/var/lib/gnx/access')
STATE = BASE / 'netbird-bootstrap.json'
MARKER = BASE / 'oidc-linked.json'


def fail(code):
    print(json.dumps({'event': 'error', 'code': code}), file=sys.stderr)
    raise SystemExit(1)


def read_private(path):
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o600:
        fail('ACCESS_SECRET_PERMISSIONS')
    return path.read_text()


def persist(path, value):
    # Secrets are written before network mutations so retries never invent new credentials.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(value, f)
        f.flush()
        os.fsync(f.fileno())


def request(service, method, path, body=None, token=None):
    port = 1411 if service == 'pocket' else 8081
    headers = {'Content-Type': 'application/json'}
    if token:
        headers['X-API-Key' if service == 'pocket' else 'Authorization'] = token if service == 'pocket' else 'Token ' + token
    req = urllib.request.Request(f'http://127.0.0.1:{port}{path}',
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            raw = r.read()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as error:
        # Annotate a fixed operation, never the response body, token or URL.
        if path.startswith('/api/identity-providers'):
            operation = 'NETBIRD_IDP'
        elif path == '/api/setup':
            operation = 'NETBIRD_SETUP'
        elif path.endswith('/secrets'):
            operation = 'POCKET_CLIENT_SECRET'
        elif path.startswith('/api/oidc/clients'):
            operation = 'POCKET_CLIENT'
        else:
            operation = service.upper() + '_DISCOVERY'
        error.gnx_operation = operation + '_' + method
        raise


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        fail('ACCESS_ENROLL_ARGUMENT')
    BASE.mkdir(exist_ok=True)
    pocket_env = dict(line.split('=', 1) for line in read_private(BASE / 'pocket-id.env').splitlines())
    api_key = pocket_env.get('STATIC_API_KEY')
    if not api_key:
        fail('POCKET_BOOTSTRAP_KEY_REQUIRED')
    for _ in range(60):
        try:
            instance = request('netbird', 'GET', '/api/instance')
            discovery = request('pocket', 'GET', '/.well-known/openid-configuration')
            break
        except (urllib.error.URLError, TimeoutError):
            time.sleep(1)
    else:
        fail('ACCESS_API_TIMEOUT')
    if discovery.get('issuer') != 'https://pocket.gnx':
        fail('POCKET_ISSUER_INVALID')
    if MARKER.exists():
        linked = json.loads(read_private(MARKER))
        client = request('pocket', 'GET', '/api/oidc/clients/' + linked['client_id'], token=api_key)
        if 'https://netbird.gnx/oauth2/callback' not in client.get('callbackURLs', []):
            fail('POCKET_CALLBACK_INVALID')
        print('{"event":"oidc_linked","provider":"pocketid","operator_passkey":"required"}')
        return
    if not STATE.exists():
        if not instance.get('setup_required'):
            fail('NETBIRD_EXISTING_OWNER_REQUIRES_ENROLLMENT')
        persist(STATE, {'email': 'admin@gnx.local', 'password': secrets.token_urlsafe(32),
                        'client_id': 'gnx-netbird', 'client_secret': secrets.token_urlsafe(32)})
    state = json.loads(read_private(STATE))
    if instance.get('setup_required'):
        owner = request('netbird', 'POST', '/api/setup', {
            'email': state['email'], 'password': state['password'], 'name': 'GnX local recovery administrator',
            'create_pat': True, 'pat_expire_in': 1,
        })
        token = owner.get('personal_access_token')
        if not token:
            fail('NETBIRD_SETUP_PAT_UNAVAILABLE')
        # Persist only the setup response needed for a retry; never emit it.
        response_file = BASE / 'netbird-enrollment.json'
        if not response_file.exists():
            persist(response_file, {'token': token, 'user_id': owner['user_id']})
    else:
        response_file = BASE / 'netbird-enrollment.json'
        if not response_file.exists():
            fail('NETBIRD_ENROLLMENT_TOKEN_REQUIRED')
        token = json.loads(read_private(response_file))['token']
    try:
        request('pocket', 'GET', '/api/oidc/clients/' + state['client_id'], token=api_key)
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise
        request('pocket', 'POST', '/api/oidc/clients', {
            'id': state['client_id'], 'name': 'GnX NetBird', 'isPublic': False,
            'callbackURLs': ['https://netbird.gnx/oauth2/callback'],
            'pkceEnabled': True, 'skipConsent': False,
        }, api_key)
    secret_marker = BASE / 'pocket-client-secret.json'
    if not secret_marker.exists():
        secret = request('pocket', 'POST', '/api/oidc/clients/' + state['client_id'] + '/secrets',
                         {'secret': state['client_secret']}, api_key)
        persist(secret_marker, {'id': secret['id']})
    providers = request('netbird', 'GET', '/api/identity-providers', token=token)
    matching = [p for p in providers if p.get('issuer') == 'https://pocket.gnx' and p.get('client_id') == state['client_id']]
    if not matching:
        provider = request('netbird', 'POST', '/api/identity-providers', {
            'type': 'pocketid', 'name': 'Pocket ID', 'issuer': 'https://pocket.gnx',
            'client_id': state['client_id'], 'client_secret': state['client_secret'],
        }, token)
    else:
        provider = matching[0]
    persist(MARKER, {'client_id': state['client_id'], 'provider_id': provider['id']})
    print('{"event":"oidc_linked","provider":"pocketid","operator_passkey":"required"}')


try:
    main()
except urllib.error.HTTPError as e:
    fail('ACCESS_ENROLL_' + getattr(e, 'gnx_operation', 'API') + '_HTTP_' + str(e.code))
except (OSError, ValueError, KeyError):
    fail('ACCESS_ENROLL_FAILED')
