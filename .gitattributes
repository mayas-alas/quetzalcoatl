*.zip -text diff=zip

# Force LF line endings for all text files
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.rs text eol=lf
*.tf text eol=lf
*.txt text eol=lf


# Extension-less runtime shell scripts: install-time payload hashes are LF-based.
runtime/commands/* text eol=lf
runtime/operations/* text eol=lf
platform/operations/* text eol=lf
platform/tofu/*/entrypoint text eol=lf
# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.zst binary
*.dll binary
*.exe binary
*.so binary
*.lib binary
*.a binary
*.pdb binary
*.idb binary
*.exp binary
*.ilk binary
*.obj binary
*.o binary
